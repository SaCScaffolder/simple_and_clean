#!/usr/bin/env bash
# Pre-commit hook: run the same smoke tests + coverage gate CI runs on push.
#
# Why: catches regressions like the commit 5808d00 / 567509f template fixes
# landing without a corresponding test update, which broke CI on push.
# Running the tests + coverage gate pre-commit is ~1-2s on a warm cache and
# gives the author the same signal CI will give on push, before the public
# history is touched.
#
# Coverage threshold is read from pyproject.toml (--cov-fail-under). If the
# local checkout fails to meet the threshold, this hook fails the commit.
#
# We skip tests marked `slow` (integration tests that touch git subprocess).
# These are known-flaky under git's pre-commit-hook invocation on Windows
# (ref-store flush timing under coverage instrumentation) but pass cleanly
# under CI's plain pytest invocation. CI still runs them; the hook doesn't.
# See the changelog entry on the #48 commit for the rationale.
#
# To install (one-time per clone):
#   git config core.hooksPath .githooks
#
# To bypass in an emergency (e.g., WIP commit):
#   git commit --no-verify -m "..."

set -euo pipefail

# Find a python interpreter. Prefer python3 (unix), fall back to python
# (Windows default), fall back to py launcher (Windows python.org install).
if command -v python3 >/dev/null 2>&1; then
  PYTHON=python3
elif command -v python >/dev/null 2>&1; then
  PYTHON=python
elif command -v py >/dev/null 2>&1; then
  PYTHON=py
else
  echo "fatal: no python interpreter found in PATH" >&2
  exit 1
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "==> running tests + coverage gate (pre-commit hook, python=$PYTHON, -m 'not slow') ..."
$PYTHON -m pytest -q -m "not slow"
echo "==> tests passed and coverage threshold met."