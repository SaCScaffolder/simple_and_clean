{
  "name": "@servicectl/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for programmatic use of servicectl. Define a ServiceConfig in TypeScript, scaffold a service, and consume the result with typed accessors.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "servicectl",
    "platform-engineering",
    "scaffolding",
    "ci-cd",
    "devops",
    "sdk"
  ],
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
