# {{ service_name }} - one-time GCP bootstrap for passwordless CD via Workload Identity Federation.
# Generated by servicectl. Run this ONCE per GCP project before the first `terraform apply`.
#
# This is the PowerShell 7+ (pwsh) parallel of `bootstrap.sh`. Both scripts do
# the same work; pick the one that matches your shell.
#   - Windows:  pwsh infra/bootstrap.ps1
#   - macOS/Linux:  bash infra/bootstrap.sh
#
# PowerShell 7+ is required (`pwsh` on PATH). On Windows you can install it
# via `winget install Microsoft.PowerShell` or by downloading from
# https://aka.ms/powershell. The script does NOT auto-detect and falls back
# to Windows PowerShell 5.1; if you need 5.1 support, open an issue.
#
# What this does:
#   1. Enables the IAM, Security Token Service, and Resource Manager APIs
#   2. Creates a Workload Identity Pool for GitHub Actions
#   3. Creates a Workload Identity Provider bound to your GitHub repo
#   4. Creates a CI service account with broad-enough roles to deploy
#   5. Allows the WIF provider to impersonate that service account
#   6. Prints the values you need to set as GitHub Actions secrets
#
# Prereqs:
#   - PowerShell 7+ on PATH (verify with: pwsh -Command '$PSVersionTable.PSVersion')
#   - gcloud installed and on PATH (the script calls `gcloud`; verify with: gcloud --version)
#   - gcloud auth login completed (gcloud auth login)
#   - gcloud config set project <your-gcp-project-id>
#   - Terraform plan/apply has been run at least once to create the runtime SA
#
# Usage:
#   pwsh infra/bootstrap.ps1
#   # copy the printed GitHub secrets into your repo's Settings -> Secrets and variables -> Actions

#Requires -Version 7.0

# Strict mode: throw on uninitialized, fail on unhandled errors, fail on
# errors from external commands (gcloud) instead of continuing silently.
# Equivalent to bash's `set -euo pipefail`.
Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

# ---- Configuration ---------------------------------------------------------

# Project ID: prefer the GCP_PROJECT_ID env var; fall back to the value the
# scaffolder rendered into infra/*.tfvars. The placeholder refusal mirrors
# bootstrap.sh's `if [[ "$PROJECT_ID" == "REPLACE_WITH_GCP_PROJECT_ID" ]]`.
$ProjectId = if ($env:GCP_PROJECT_ID) { $env:GCP_PROJECT_ID } else { '{{ gcp_project_id }}' }

# GitHub repo: prefer the GITHUB_REPO env var; fall back to parsing the
# `origin` git remote. bash's `git remote get-url origin | sed -E '...'` is
# replicated here in PowerShell.
if (-not $env:GITHUB_REPO) {
    try {
        $remoteUrl = git remote get-url origin 2>$null
        if ($remoteUrl) {
            # Match either git@github.com:owner/repo.git or https://github.com/owner/repo.git
            if ($remoteUrl -match 'github\.com[:/](.+)\.git$') {
                $env:GITHUB_REPO = $Matches[1]
            }
        }
    } catch {
        # `git remote get-url` fails when there's no `origin`. Fall through
        # to the user-controlled error path below.
    }
}
$GitHubRepo = $env:GITHUB_REPO

if (-not $ProjectId -or $ProjectId -eq 'REPLACE_WITH_GCP_PROJECT_ID') {
    Write-Error "GCP_PROJECT_ID not set and {{ gcp_project_id }} is still the placeholder.`n" `
        "Either set `$env:GCP_PROJECT_ID = 'my-project', or edit infra/*.tfvars to set project_id, then re-run."
    exit 1
}

if (-not $GitHubRepo) {
    Write-Error "GITHUB_REPO not set and no `origin` remote detected.`n" `
        "Either set `$env:GITHUB_REPO = 'owner/repo', or run `git remote add origin git@github.com:owner/repo.git` first."
    exit 1
}

# GCP resource IDs (pool, provider, SA) disallow underscores, so we use
# {{ service_id }} (always dashed-lowercase after renderer __post_init__)
# rather than the raw user-typed service_name.
$PoolId = '{{ service_id }}-github-pool'
$ProviderId = '{{ service_id }}-github-provider'
$CiSaId = '{{ service_id }}-ci'

# GCP caps display names at 32 characters (silent reject on `create` with
# INVALID_ARGUMENT otherwise). Keep all three display names short enough
# that a long service_name or repo path still fits. The 32-char truncation
# below is the safety net; the strings above are tuned so the typical case
# doesn't hit it.
# Equivalent of bash's `${VAR:0:32}`: if the string is longer than 32 chars,
# take the first 32; otherwise keep it as-is.
function Limit-DisplayName {
    param([string]$Name)
    if ($Name.Length -gt 32) { return $Name.Substring(0, 32) }
    return $Name
}

$DisplayPool = Limit-DisplayName '{{ service_id }} gh pool'
$DisplayProvider = Limit-DisplayName "gh for $GitHubRepo"
$DisplayCiSa = Limit-DisplayName '{{ service_id }} ci sa'

# Build the REPO_QUALIFIED identifier exactly the same way bash does.
# `projects/${PROJECT_ID}/locations/global/workloadIdentityPools/${POOL_ID}/providers/${PROVIDER_ID}`
$RepoQualified = "projects/$ProjectId/locations/global/workloadIdentityPools/$PoolId/providers/$ProviderId"
$CiSaEmail = "$CiSaId@$ProjectId.iam.gserviceaccount.com"

Write-Host "==> Project:       $ProjectId"
Write-Host "==> GitHub repo:   $GitHubRepo"
Write-Host "==> WIF pool:      $PoolId"
Write-Host "==> WIF provider:  $ProviderId"
Write-Host "==> CI service acct: $CiSaId"
Write-Host ""

# ---- 1. Enable required APIs ----------------------------------------------

Write-Host "==> Enabling required APIs..."
& gcloud services enable `
    iam.googleapis.com `
    iamcredentials.googleapis.com `
    sts.googleapis.com `
    cloudresourcemanager.googleapis.com `
    --project="$ProjectId" | Out-Null

# ---- 2. Create Workload Identity Pool --------------------------------------

Write-Host "==> Creating Workload Identity Pool (idempotent)..."
# bash's `if ! cmd; then ...; fi` maps to PowerShell's `if ($LASTEXITCODE -ne 0)`
# AFTER the call. Note: we don't use `if (-not $LASTEXITCODE -eq 0)` because
# `-not` on an integer is a bool flip and `if (!$LASTEXITCODE)` works but is
# less explicit. `$?` (success bool) is also valid in 7+ but `$LASTEXITCODE`
# is what the rest of the script uses.
& gcloud iam workload-identity-pools describe $PoolId --project="$ProjectId" --location=global | Out-Null
if ($LASTEXITCODE -ne 0) {
    & gcloud iam workload-identity-pools create $PoolId `
        --project="$ProjectId" `
        --location=global `
        --display-name="$DisplayPool" | Out-Null
}

# ---- 3. Create Workload Identity Provider ---------------------------------

Write-Host "==> Creating Workload Identity Provider (idempotent)..."
& gcloud iam workload-identity-pools providers describe $ProviderId `
    --project="$ProjectId" --location=global --workload-identity-pool="$PoolId" | Out-Null
if ($LASTEXITCODE -ne 0) {
    # The attribute-mapping and attribute-condition strings are passed as
    # literal CLI args. bash's single-quoted strings are direct equivalents
    # in PowerShell's double-quoted heredoc style -- except for the
    # attribute-condition, which interpolates $GitHubRepo. PowerShell's
    # double-quoted string does the same interpolation; we use a here-string
    # for the attribute-mapping to keep the literal commas and equals signs
    # readable.
    & gcloud iam workload-identity-pools providers create-oidc $ProviderId `
        --project="$ProjectId" `
        --location=global `
        --workload-identity-pool="$PoolId" `
        --display-name="$DisplayProvider" `
        --attribute-mapping="google.subject=assertion.sub,attribute.actor=assertion.actor,attribute.repository=assertion.repository,attribute.repository_owner=assertion.repository_owner,attribute.ref=assertion.ref" `
        --issuer-uri="https://token.actions.githubusercontent.com" `
        --attribute-condition="attribute.repository == '$GitHubRepo'" | Out-Null
}

# ---- 4. Create CI service account -----------------------------------------

Write-Host "==> Creating CI service account (idempotent)..."
& gcloud iam service-accounts describe $CiSaEmail --project="$ProjectId" | Out-Null
if ($LASTEXITCODE -ne 0) {
    & gcloud iam service-accounts create $CiSaId `
        --project="$ProjectId" `
        --display-name="$DisplayCiSa" `
        --description="GitHub Actions deploys as this account via WIF." | Out-Null
}

# Grant the CI SA the roles it needs to deploy.
Write-Host "==> Granting CI service account roles..."
$Roles = @(
    "roles/run.admin"
    "roles/storage.admin"
    "roles/artifactregistry.admin"
    "roles/iam.serviceAccountUser"
    "roles/cloudbuild.builds.editor"
)
foreach ($Role in $Roles) {
    & gcloud projects add-iam-policy-binding $ProjectId `
        --member="serviceAccount:$CiSaEmail" `
        --role="$Role" `
        --condition=None | Out-Null
}

# ---- 5. Allow WIF provider to impersonate CI SA ---------------------------

Write-Host "==> Binding WIF provider to CI service account..."
& gcloud iam service-accounts add-iam-policy-binding $CiSaEmail `
    --project="$ProjectId" `
    --role="roles/iam.workloadIdentityUser" `
    --member="principalSet://iam.googleapis.com/$RepoQualified/attribute.repository/$GitHubRepo" | Out-Null

# ---- 6. Print values for GitHub secrets -----------------------------------

Write-Host ""
Write-Host "================================================================="
Write-Host "  Bootstrap complete. Set these as GitHub repo secrets:"
Write-Host "  (Settings -> Secrets and variables -> Actions -> New repository secret)"
Write-Host "================================================================="
Write-Host "  GCP_PROJECT_ID                  = $ProjectId"
Write-Host "  GCP_WORKLOAD_IDENTITY_PROVIDER  = $RepoQualified"
Write-Host "  GCP_SERVICE_ACCOUNT             = $CiSaEmail"
Write-Host ""
Write-Host "  Then push to main. CI will use WIF to deploy without any JSON keys."
Write-Host "================================================================="