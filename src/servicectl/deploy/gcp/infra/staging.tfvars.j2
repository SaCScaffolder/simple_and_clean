# {{ service_name }} — staging environment
# Loaded by: terraform apply -var-file=staging.tfvars

project_id  = "{{ gcp_project_id }}"
region      = "{{ gcp_region }}"
environment = "staging"

{% if gcp_cloud_run_enabled %}
# Staging: always-on so we can run integration tests against it.
cloud_run_min_instances = 1
cloud_run_max_instances = 20
cloud_run_cpu          = "1"
cloud_run_memory       = "1Gi"
cloud_run_concurrency  = 80

env_vars = {
  LOG_LEVEL = "info"
  ENV       = "staging"
}
{% endif %}