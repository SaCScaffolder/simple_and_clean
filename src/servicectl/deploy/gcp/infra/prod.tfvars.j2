# {{ service_name }} — production environment
# Loaded by: terraform apply -var-file=prod.tfvars

project_id  = "{{ gcp_project_id }}"
region      = "{{ gcp_region }}"
environment = "prod"

{% if gcp_cloud_run_enabled %}
# Prod: always-on, generous limits, max concurrency per instance.
cloud_run_min_instances = 2
cloud_run_max_instances = 100
cloud_run_cpu          = "2"
cloud_run_memory       = "1Gi"
cloud_run_concurrency  = 100

env_vars = {
  LOG_LEVEL = "warn"
  ENV       = "prod"
}
{% endif %}

{% if gcp_postgres_enabled %}
# Cloud SQL (postgres) for prod: HA, backups, PITR. The tier
# (db-custom-2-7680 = 2 vCPU / 7.5 GB) is appropriate for a small
# service; bump via the cluster's admin console if you need more.
db_tier              = "db-custom-2-7680"
db_name              = "sac"
db_user              = "sac"
db_availability_type = "REGIONAL"
db_disk_size_gb      = 20
db_backup_enabled    = true
db_pitr_enabled      = true

pods_subnet_cidr        = "10.40.0.0/20"
pods_secondary_cidr     = "10.44.0.0/14"
services_secondary_cidr = "10.48.0.0/20"
{% endif %}