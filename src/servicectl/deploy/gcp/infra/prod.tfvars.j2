# {{ service_name }} — production environment
# Loaded by: terraform apply -var-file=prod.tfvars

project_id  = "{{ gcp_project_id }}"
region      = "{{ gcp_region }}"
environment = "prod"

{% if gcp_cloud_run_enabled %}
# Prod: always-on, generous limits, max concurrency per instance.
cloud_run_min_instances = 2
cloud_run_max_instances = 100
cloud_run_cpu          = "2"
cloud_run_memory       = "1Gi"
cloud_run_concurrency  = 100

env_vars = {
  LOG_LEVEL = "warn"
  ENV       = "prod"
}
{% endif %}