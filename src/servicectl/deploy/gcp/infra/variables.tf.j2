// {{ service_name }} — GCP input variables
// Generated by servicectl. Override via -var-file=dev.tfvars|staging.tfvars|prod.tfvars
// or -var=key=value on the CLI.

variable "project_id" {
  description = "GCP project ID hosting this service. Required."
  type        = string
  default     = "{{ gcp_project_id }}"
}

variable "region" {
  description = "GCP region for all regional resources (Cloud Run, GKE, Artifact Registry)."
  type        = string
  default     = "{{ gcp_region }}"
}

variable "environment" {
  description = "Deployment environment. Drives naming, autoscaling, and resource SKUs."
  type        = string
  default     = "dev"

  validation {
    condition     = contains(["dev", "staging", "prod"], var.environment)
    error_message = "environment must be one of: dev, staging, prod."
  }
}

variable "image" {
  description = "Container image to deploy (e.g. {{ registry }}/{{ service_name }}:sha-abc1234)."
  type        = string
  default     = "{{ registry }}/{{ service_name }}:latest"
}

{% if gcp_cloud_run_enabled %}
variable "cloud_run_min_instances" {
  description = "Cloud Run minimum instance count. 0 = scale to zero (cost-optimized for dev); 1+ = always-warm."
  type        = number
  default     = 0
}

variable "cloud_run_max_instances" {
  description = "Cloud Run maximum instance count. Caps cost during traffic spikes."
  type        = number
  default     = 100
}

variable "cloud_run_cpu" {
  description = "CPU allocation per Cloud Run instance. '1' = 1 vCPU; '2' = 2 vCPU."
  type        = string
  default     = "1"
}

variable "cloud_run_memory" {
  description = "Memory allocation per Cloud Run instance. Examples: '512Mi', '1Gi', '2Gi'."
  type        = string
  default     = "512Mi"
}

variable "cloud_run_concurrency" {
  description = "Maximum concurrent requests per Cloud Run instance."
  type        = number
  default     = 80
}

variable "env_vars" {
  description = "Environment variables to inject into the Cloud Run service. Secrets should NOT be passed here — use Secret Manager references instead."
  type        = map(string)
  default     = {}
}
{% endif %}