#!/usr/bin/env bash
# {{ service_name }} — one-time GCP bootstrap for passwordless CD via Workload Identity Federation.
# Generated by servicectl. Run this ONCE per GCP project before the first `terraform apply`.
#
# What this does:
#   1. Enables the IAM, Security Token Service, and Resource Manager APIs
#   2. Creates a Workload Identity Pool for GitHub Actions
#   3. Creates a Workload Identity Provider bound to your GitHub repo
#   4. Creates a CI service account with broad-enough roles to deploy
#   5. Allows the WIF provider to impersonate that service account
#   6. Prints the values you need to set as GitHub Actions secrets
#
# Prereqs:
#   - gcloud installed and on PATH
#   - gcloud auth login completed (gcloud auth login)
#   - gcloud config set project <your-gcp-project-id>
#   - jq installed (used for parsing)
#   - Terraform plan/apply has been run at least once to create the runtime SA
#
# Usage:
#   bash infra/bootstrap.sh
#   # copy the printed GitHub secrets into your repo's Settings -> Secrets and variables -> Actions

set -euo pipefail

# ---- Configuration ---------------------------------------------------------

PROJECT_ID="${GCP_PROJECT_ID:-{{ gcp_project_id }}}"
GITHUB_REPO="${GITHUB_REPO:-$(git remote get-url origin 2>/dev/null | sed -E 's#.*github.com[:/](.+)\.git#\1#')}"

if [[ -z "$PROJECT_ID" || "$PROJECT_ID" == "REPLACE_WITH_GCP_PROJECT_ID" ]]; then
  echo "ERROR: GCP_PROJECT_ID not set and {{ gcp_project_id }} is still the placeholder." >&2
  echo "Either export GCP_PROJECT_ID=my-project, or edit infra/*.tfvars to set project_id, then re-run." >&2
  exit 1
fi

if [[ -z "$GITHUB_REPO" ]]; then
  echo "ERROR: GITHUB_REPO not set and no `origin` remote detected." >&2
  echo "Either export GITHUB_REPO=owner/repo, or `git remote add origin git@github.com:owner/repo.git` first." >&2
  exit 1
fi

# GCP resource IDs (pool, provider, SA) disallow underscores, so we use the
# dashed service_name (e.g. `my-svc`) rather than the snake-cased variant.
POOL_ID="{{ service_name }}-github-pool"
PROVIDER_ID="{{ service_name }}-github-provider"
CI_SA_ID="{{ service_name }}-ci"

echo "==> Project:       $PROJECT_ID"
echo "==> GitHub repo:   $GITHUB_REPO"
echo "==> WIF pool:      $POOL_ID"
echo "==> WIF provider:  $PROVIDER_ID"
echo "==> CI service acct: $CI_SA_ID"
echo

# ---- 1. Enable required APIs ----------------------------------------------

echo "==> Enabling required APIs..."
gcloud services enable \
    iam.googleapis.com \
    iamcredentials.googleapis.com \
    sts.googleapis.com \
    cloudresourcemanager.googleapis.com \
    --project="$PROJECT_ID" >/dev/null

# ---- 2. Create Workload Identity Pool --------------------------------------

echo "==> Creating Workload Identity Pool (idempotent)..."
if ! gcloud iam workload-identity-pools describe "$POOL_ID" --project="$PROJECT_ID" --location=global >/dev/null 2>&1; then
  gcloud iam workload-identity-pools create "$POOL_ID" \
      --project="$PROJECT_ID" \
      --location=global \
      --display-name="{{ service_name }} GitHub Actions pool" \
      >/dev/null
fi

# ---- 3. Create Workload Identity Provider ---------------------------------

echo "==> Creating Workload Identity Provider (idempotent)..."
REPO_QUALIFIED="projects/${PROJECT_ID}/locations/global/workloadIdentityPools/${POOL_ID}/providers/${PROVIDER_ID}"
if ! gcloud iam workload-identity-pools providers describe "$PROVIDER_ID" \
    --project="$PROJECT_ID" --location=global --workload-identity-pool="$POOL_ID" >/dev/null 2>&1; then
  gcloud iam workload-identity-pools providers create-oidc "$PROVIDER_ID" \
      --project="$PROJECT_ID" \
      --location=global \
      --workload-identity-pool="$POOL_ID" \
      --display-name="GitHub Actions for ${GITHUB_REPO}" \
      --attribute-mapping="google.subject=assertion.sub,attribute.actor=assertion.actor,attribute.repository=assertion.repository,attribute.repository_owner=assertion.repository_owner,attribute.ref=assertion.ref" \
      --issuer-uri="https://token.actions.githubusercontent.com" \
      --attribute-condition="attribute.repository == '${GITHUB_REPO}'" \
      >/dev/null
fi

# ---- 4. Create CI service account -----------------------------------------

echo "==> Creating CI service account (idempotent)..."
CI_SA_EMAIL="${CI_SA_ID}@${PROJECT_ID}.iam.gserviceaccount.com"
if ! gcloud iam service-accounts describe "$CI_SA_EMAIL" --project="$PROJECT_ID" >/dev/null 2>&1; then
  gcloud iam service-accounts create "$CI_SA_ID" \
      --project="$PROJECT_ID" \
      --display-name="{{ service_name }} CI service account" \
      --description="GitHub Actions deploys as this account via WIF." \
      >/dev/null
fi

# Grant the CI SA the roles it needs to deploy.
echo "==> Granting CI service account roles..."
for ROLE in \
    "roles/run.admin" \
    "roles/storage.admin" \
    "roles/artifactregistry.admin" \
    "roles/iam.serviceAccountUser" \
    "roles/cloudbuild.builds.editor"
do
  gcloud projects add-iam-policy-binding "$PROJECT_ID" \
      --member="serviceAccount:${CI_SA_EMAIL}" \
      --role="$ROLE" \
      --condition=None \
      >/dev/null
done

# ---- 5. Allow WIF provider to impersonate CI SA ---------------------------

echo "==> Binding WIF provider to CI service account..."
gcloud iam service-accounts add-iam-policy-binding "$CI_SA_EMAIL" \
    --project="$PROJECT_ID" \
    --role="roles/iam.workloadIdentityUser" \
    --member="principalSet://iam.googleapis.com/${REPO_QUALIFIED}/attribute.repository/${GITHUB_REPO}" \
    >/dev/null

# ---- 6. Print values for GitHub secrets -----------------------------------

echo
echo "================================================================="
echo "  Bootstrap complete. Set these as GitHub repo secrets:"
echo "  (Settings -> Secrets and variables -> Actions -> New repository secret)"
echo "================================================================="
echo "  GCP_PROJECT_ID               = $PROJECT_ID"
echo "  GCP_WORKLOAD_IDENTITY_PROVIDER = $REPO_QUALIFIED"
echo "  GCP_SERVICE_ACCOUNT          = $CI_SA_EMAIL"
echo
echo "  Then push to main. CI will use WIF to deploy without any JSON keys."
echo "================================================================="