{% if gcp_cloud_run_enabled %}
# {{ service_name }} — GCP infrastructure (Cloud Run)
# Generated by servicectl. Edit as needed; this is the starting point.
#
# What this provisions:
#   - Service account for Cloud Run runtime (least-privilege, no keys)
#   - Artifact Registry repository (Docker images)
#   - Cloud Run service (serverless, HTTPS, autoscaling)
#   - IAM allowing the GitHub Actions OIDC principal to deploy
#
# Companion files:
#   - variables.tf      : input variables (region, project_id, image, etc.)
#   - dev.tfvars        : dev environment
#   - staging.tfvars    : staging environment
#   - prod.tfvars       : production environment
#   - outputs.tf        : useful outputs (service URL, image, etc.)
#   - bootstrap.sh      : one-time setup of WIF + service accounts
#   - ../deploy.yml     : GitHub Actions workflow that calls `terraform apply`
#
# Apply:
#   cd infra
#   terraform init
#   terraform plan -var-file=dev.tfvars
#   terraform apply -var-file=dev.tfvars
#
# Or push to main and let CI do it (deploy.yml uses WIF for passwordless auth).
{% elif gcp_gke_autopilot_enabled %}
# {{ service_name }} — GCP infrastructure (GKE Autopilot)
# Generated by servicectl. Edit as needed; this is the starting point.
#
# What this provisions:
#   - Service account for pod runtime (Workload Identity binding)
#   - Artifact Registry repository (Docker images)
#   - GKE Autopilot cluster (fully managed nodes, pay-per-pod)
#   - Kubernetes namespace + service account + Workload Identity binding
#   - IAM allowing the GitHub Actions OIDC principal to deploy
#
# Companion files:
#   - variables.tf      : input variables
#   - dev.tfvars        : dev environment
#   - staging.tfvars    : staging environment
#   - prod.tfvars       : production environment
#   - outputs.tf        : useful outputs (cluster name, registry, kubeconfig command)
#   - bootstrap.sh      : one-time setup of WIF + service accounts
#   - ../deploy.yml     : GitHub Actions workflow that calls `terraform apply`
#                         then kustomize-apply
#
# Apply:
#   cd infra
#   terraform init
#   terraform plan -var-file=dev.tfvars
#   terraform apply -var-file=dev.tfvars
#   gcloud container clusters get-credentials $(terraform output -raw cluster_name) \
#       --region $(terraform output -raw cluster_region) --project $(terraform output -raw project_id)
#   kubectl apply -k ../k8s/overlays/dev
{% endif %}

terraform {
  required_version = ">= 1.5.0"

  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 5.40"
    }
    google-beta = {
      source  = "hashicorp/google-beta"
      version = "~> 5.40"
    }
  }

  # Backend is intentionally local for v1. To enable team-wide state locking,
  # uncomment the `backend "gcs"` block and create a GCS bucket beforehand.
  # (See docs/development.md#state-backends for the recipe.)
  #
  # backend "gcs" {
  #   bucket = "{{ service_name }}-tfstate"
  #   prefix = "terraform/state"
  # }
}

provider "google" {
  project = var.project_id
  region  = var.region
}

provider "google-beta" {
  project = var.project_id
  region  = var.region
}

# --- Shared resources (used by both Cloud Run and GKE Autopilot overlays) ---

# Runtime service account: pods / Cloud Run instances run as this identity.
# It starts empty; grant additional roles in the per-target module below
# (e.g. Cloud SQL Client, Secret Accessor, Pub/Sub Publisher).
#
# GCP service account IDs disallow underscores (regex: ^[a-z](?:[-a-z0-9]{4,28}[a-z0-9])$),
# so we use the dashed service_name (e.g. `my-svc`) directly.
resource "google_service_account" "runtime" {
  account_id   = "{{ service_name }}-runtime"
  display_name = "{{ service_name }} runtime service account"
  description  = "Least-privilege identity for the {{ service_name }} service at runtime."
}

# Artifact Registry repository for container images.
# Artifact Registry IDs allow letters, digits, dashes, underscores; we use the
# dashed service_name for consistency with the service account above.
resource "google_artifact_registry_repository" "images" {
  repository_id = "{{ service_name }}"
  description   = "Docker images for {{ service_name }}"
  format        = "DOCKER"
  location      = var.region

  # Prevent accidental deletion of images with active tags.
  cleanup_policy_dry_run = false
  cleanup_policies {
    id     = "keep-minimum-versions"
    action = "KEEP"
    condition {
      tag_state             = "TAGGED"
      tag_prefixes          = ["v"]
      older_than            = "2592000s" # 30 days
    }
  }
  cleanup_policies {
    id     = "delete-untagged"
    action = "DELETE"
    condition {
      tag_state  = "UNTAGGED"
      older_than = "604800s" # 7 days
    }
  }

  depends_on = [google_project_service.artifactregistry]
}

# Enable required Google Cloud APIs. Doing this in Terraform (rather than
# out-of-band) makes the project self-bootstrapping: a fresh GCP project
# only needs billing enabled before `terraform apply` will work.
resource "google_project_service" "artifactregistry" {
  service            = "artifactregistry.googleapis.com"
  disable_on_destroy = false
}

# --- Per-target resources ----------------------------------------------------

{% if gcp_cloud_run_enabled %}
module "cloud_run" {
  source = "./modules/cloud_run"

  project_id           = var.project_id
  region               = var.region
  service_name         = "{{ service_name }}"
  image                = var.image
  runtime_sa_email     = google_service_account.runtime.email
  artifact_registry_repo = google_artifact_registry_repository.images.name
  environment          = var.environment
  min_instance_count   = var.cloud_run_min_instances
  max_instance_count   = var.cloud_run_max_instances
  cpu                  = var.cloud_run_cpu
  memory               = var.cloud_run_memory
  concurrency          = var.cloud_run_concurrency
  env_vars             = var.env_vars
}
{% elif gcp_gke_autopilot_enabled %}
module "gke_autopilot" {
  source = "./modules/gke_autopilot"

  project_id            = var.project_id
  region                = var.region
  cluster_name          = "{{ service_name }}-{{ '{{' }}var.environment{{ '}}' }}"
  runtime_sa_email      = google_service_account.runtime.email
  artifact_registry_repo = google_artifact_registry_repository.images.name
  environment           = var.environment
}

# Allow the kustomize base to pull from the Artifact Registry.
resource "google_artifact_registry_repository_iam_member" "runtime_pull" {
  project    = var.project_id
  location   = google_artifact_registry_repository.images.location
  repository = google_artifact_registry_repository.images.name
  role       = "roles/artifactregistry.reader"
  member     = "serviceAccount:${google_service_account.runtime.email}"
}
{% endif %}