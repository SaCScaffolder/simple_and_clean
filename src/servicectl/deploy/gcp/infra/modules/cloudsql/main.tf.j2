// Cloud SQL (postgres) module for {{ service_name }}.
// Provisions a managed Postgres instance reachable on a private IP
// inside the same VPC the GKE Autopilot cluster lives in. Pods reach
// the instance via the Cloud SQL Auth Proxy sidecar (see k8s/cloudsql-proxy.yaml
// in PR 2) using a connection name of the form
// `<project>:<region>:<instance>`.
//
// Design notes:
//   - Private IP only (no public IP). The instance is unreachable from
//     the public internet; only authorized clients inside the VPC (or
//     peered networks) can connect. This is the default for any
//     production postgres we put in scope.
//   - Password is generated by `random_password`, stored in Secret
//     Manager, and surfaced as a k8s Secret by deploy.yml (PR 3). The
//     DB user is created with that same password. The instance is
//     inaccessible without a valid password (no trust via IAM for
//     postgres in v1; we use the password for now because the
//     Cloud SQL Auth Proxy is the only path pods take to the DB and
//     IAM auth for postgres requires the instance to have a public IP
//     or a self-signed cert chain to be trusted, both of which add
//     complexity that's not portfolio-valuable).
//   - The GKE Autopilot cluster's runtime SA gets the
//     `roles/cloudsql.client` role, which authorizes it to call the
//     Cloud SQL Admin API to mint short-lived certificates for the
//     Auth Proxy. The actual connection to postgres is over the VPC
//     private IP, but the Auth Proxy needs to call
//     `generateEphemeralCert` to authenticate the connection -- and
//     that call is gated on `cloudsql.client`.
//   - The module creates the network resources it needs (a dedicated
//     VPC, subnetwork, private services range) rather than reusing
//     the default network. Reason: the default network is shared with
//     every other GCP project resource and has no predictable IP
//     space. A dedicated VPC gives us deterministic CIDRs and clean
//     teardown (terraform destroy removes the VPC entirely, no
//     residual routes).
//   - This module only makes sense with `--deploy=gcp-gke-autopilot`;
//     a Cloud Run + Cloud SQL wiring is a separate overlay (filed as
//     a follow-up issue, out of scope for this milestone).

resource "google_project_service" "sqladmin" {
  service            = "sqladmin.googleapis.com"
  disable_on_destroy = false
}

resource "google_project_service" "servicenetworking" {
  service            = "servicenetworking.googleapis.com"
  disable_on_destroy = false
}

# Dedicated VPC for the GKE cluster and Cloud SQL. Auto-mode would also
# work, but custom-mode gives us a deterministic CIDR range that won't
# collide with anything in the project's default network, which matters
# when the project is shared with other workloads.
resource "google_compute_network" "main" {
  name                    = "{{ service_id }}-vpc"
  auto_create_subnetworks = false
  routing_mode            = "REGIONAL"

  depends_on = [google_project_service.servicenetworking]
}

# Subnet for the GKE Autopilot cluster's pods. Autopilot picks node
# CIDRs from this subnetwork's range.
resource "google_compute_subnetwork" "pods" {
  name          = "{{ service_id }}-pods"
  ip_cidr_range = var.pods_subnet_cidr
  region        = var.region
  network       = google_compute_network.main.id

  # Autopilot uses alias IPs, so we need a secondary range for pods and
  # one for services. The services range is small because we don't
  # expose many ClusterIPs to the VPC.
  secondary_ip_range {
    range_name    = "pods"
    ip_cidr_range = var.pods_secondary_cidr
  }
  secondary_ip_range {
    range_name    = "services"
    ip_cidr_range = var.services_secondary_cidr
  }
}

# Reserved global address for the private services range. This is the
# IP block Cloud SQL will use when peered into our VPC. It must be a
# /16 and must not overlap with any other range in the VPC.
resource "google_compute_global_address" "private_services" {
  name          = "{{ service_id }}-private-services"
  purpose       = "VPC_PEERING"
  address_type  = "INTERNAL"
  ip_version    = "IPV4"
  prefix_length = 16
  network       = google_compute_network.main.id
}

# Wire the private services range to GCP's `servicenetworking` service
# so that Cloud SQL can be peered in. Without this, creating the
# `google_sql_database_instance` with `ip_configuration.private_network`
# would fail with "no peering".
resource "google_service_networking_connection" "private_services" {
  network                 = google_compute_network.main.id
  service                 = "servicenetworking.googleapis.com"
  reserved_peering_ranges = [google_compute_global_address.private_services.name]

  depends_on = [google_project_service.servicenetworking]
}

# Random password for the DB user. Stored in Secret Manager and surfaced
# as a k8s Secret by deploy.yml (PR 3).
resource "random_password" "db_password" {
  length           = 24
  special          = true
  override_special = "!#$%&*()-_=+[]{}<>:?"
}

# Secret Manager secret + initial version. The CI deploy workflow
# fetches this into a k8s Secret (PR 3) and rotates it on a schedule
# (future work).
resource "google_secret_manager_secret" "db_password" {
  secret_id = "{{ service_id }}-db-password-${var.environment}"

  labels = {
    service     = "{{ service_id }}"
    environment = var.environment
    managed_by  = "servicectl"
  }

  replication {
    auto {}
  }

  depends_on = [google_project_service.sqladmin]
}

resource "google_secret_manager_secret_version" "db_password" {
  secret      = google_secret_manager_secret.db_password.id
  secret_data = random_password.db_password.result
}

# The postgres instance. `db-f1-micro` is 1 vCPU / 0.6 GB RAM and
# costs $9/mo -- enough for a portfolio piece. Production-sized
# instances use `db-custom-N-MEM` SKUs (see prod.tfvars).
#
# `availability_type` is REGIONAL for prod (HA), ZONAL for dev/staging
# (cheaper). The .tfvars file drives this choice.
#
# `backup_configuration.enabled` is on for prod, off for dev/staging
# to save cost.
resource "google_sql_database_instance" "main" {
  name             = "{{ service_id }}-${var.environment}"
  database_version = "POSTGRES_16"
  region           = var.region

  # `settings` is wrapped in a `dynamic` block so the entire tier
  # configuration can be overridden by a single `db_tier` var. The
  # defaults below are sensible for dev; prod overrides via .tfvars.
  settings {
    tier              = var.db_tier
    availability_type = var.db_availability_type
    disk_size         = var.db_disk_size_gb
    disk_type         = "PD_SSD"

    backup_configuration {
      enabled            = var.db_backup_enabled
      start_time         = var.db_backup_start_time
      point_in_time_recovery_enabled = var.db_pitr_enabled
    }

    # Maintenance windows are Sunday 04:00-05:00 UTC for all envs.
    # Reason: lowest traffic on the portfolio demo, and avoids the
    # weekday 04:00-05:00 UTC window when most GCP maintenance
    # actually runs (we want a different slot to avoid overlapping
    # with the upstream GKE Autopilot maintenance cycle).
    maintenance_window {
      day          = 7
      hour         = 4
      update_track = "stable"
    }

    ip_configuration {
      # Private IP only. The instance is unreachable from the public
      # internet.
      ipv4_enabled    = false
      private_network = google_compute_network.main.id
    }
  }

  # Prevent Terraform from replacing the instance on a `password` change
  # (the password rotation goes through Secret Manager, not the
  # instance's `root_password` field, which is unset here).
  lifecycle {
    ignore_changes = [
      settings[0].backup_configuration[0].enabled,
    ]
  }

  deletion_protection = var.environment == "prod"

  depends_on = [
    google_service_networking_connection.private_services,
    google_project_service.sqladmin,
  ]
}

# The application database. A separate `google_sql_database` resource
# so the DB name is configurable via .tfvars.
resource "google_sql_database" "main" {
  name      = var.db_name
  instance  = google_sql_database_instance.main.name
  charset   = "UTF8"
  collation = "en_US.UTF8"
}

# The application user. Password comes from `random_password` and
# is also stored in Secret Manager.
resource "google_sql_user" "main" {
  name     = var.db_user
  instance = google_sql_database_instance.main.name
  password = random_password.db_password.result
}

# Allow the runtime k8s service account to connect via the Cloud SQL
# Auth Proxy. The proxy calls `generateEphemeralCert` on the
# `cloudsql.instances.get` / `cloudsql.instances.connect` APIs to
# mint short-lived client certificates; both calls are gated on
# `roles/cloudsql.client`.
#
# Note: the runtime_sa_email here is the GCP SA, not the k8s SA.
# The k8s SA is bound to the GCP SA via Workload Identity (see
# k8s/serviceaccount.yaml in PR 2), so granting this role on the
# GCP SA is sufficient.
resource "google_project_iam_member" "cloudsql_client" {
  project = var.project_id
  role    = "roles/cloudsql.client"
  member  = "serviceAccount:${var.runtime_sa_email}"
}

# Also allow the runtime SA to read the password secret (the proxy
# sidecar doesn't strictly need this for v1, but the application's
# own init container does if it wants to call psql directly for
# migrations, and it's cheap to grant).
resource "google_secret_manager_secret_iam_member" "db_password_reader" {
  secret_id = google_secret_manager_secret.db_password.secret_id
  role      = "roles/secretmanager.secretAccessor"
  member    = "serviceAccount:${var.runtime_sa_email}"
}
