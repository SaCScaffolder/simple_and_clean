// {{ service_name }} — GCP outputs
// Generated by servicectl.

{% if gcp_cloud_run_enabled %}
output "service_url" {
  description = "Public HTTPS URL of the Cloud Run service."
  value       = module.cloud_run.service_url
}

output "runtime_sa_email" {
  description = "Email of the runtime service account. Grant additional IAM roles here."
  value       = google_service_account.runtime.email
}

output "artifact_registry_repo" {
  description = "Artifact Registry repository name (under projects/{{ '{{' }}project_id{{ '}}' }}/locations/{{ '{{' }}region{{ '}}' }}/repos/)."
  value       = google_artifact_registry_repository.images.name
}

output "artifact_registry_image" {
  description = "Fully qualified image reference (push target)."
  value       = "${var.region}-docker.pkg.dev/${var.project_id}/${google_artifact_registry_repository.images.name}/${var.image}"
}
{% elif gcp_gke_autopilot_enabled %}
output "cluster_name" {
  description = "GKE Autopilot cluster name."
  value       = module.gke_autopilot.cluster_name
}

output "cluster_region" {
  description = "GKE Autopilot cluster region."
  value       = var.region
}

output "cluster_endpoint" {
  description = "GKE cluster endpoint (sensitive). Use `gcloud container clusters get-credentials` to populate kubeconfig."
  value       = module.gke_autopilot.cluster_endpoint
  sensitive   = true
}

output "kubeconfig_command" {
  description = "Copy/paste command to fetch kubeconfig for this cluster."
  value       = "gcloud container clusters get-credentials ${module.gke_autopilot.cluster_name} --region ${var.region} --project ${var.project_id}"
}

output "runtime_sa_email" {
  description = "Email of the runtime Kubernetes service account. Bind to Kubernetes SA via Workload Identity."
  value       = google_service_account.runtime.email
}

output "artifact_registry_image" {
  description = "Fully qualified image reference (push target)."
  value       = "${var.region}-docker.pkg.dev/${var.project_id}/${google_artifact_registry_repository.images.name}/${var.image}"
}

{% if gcp_postgres_enabled %}
# --- Cloud SQL (postgres) outputs --------------------------------------------
#
# Used by deploy.yml (PR 3) to fetch the password into a k8s Secret and by
# k8s/cloudsql-proxy.yaml (PR 2) to point the Auth Proxy at the instance.
# `connection_name` is the form Cloud SQL Auth Proxy wants: `<project>:<region>:<instance>`.
output "db_connection_name" {
  description = "Cloud SQL connection name (`<project>:<region>:<instance>`). Consumed by the cloudsql-proxy sidecar."
  value       = module.cloudsql.connection_name
}

output "db_private_ip" {
  description = "Private IP of the Cloud SQL instance. Reachable only from inside the VPC."
  value       = module.cloudsql.private_ip
}

output "db_name" {
  description = "Application database name. The `DATABASE_URL` the Go service uses has this as the path component."
  value       = module.cloudsql.database_name
}

output "db_user" {
  description = "Application database user. The `DATABASE_URL` has this as the userinfo component."
  value       = module.cloudsql.database_user
}

output "db_password_secret_id" {
  description = "Secret Manager secret ID holding the random DB password. `deploy.yml` (PR 3) reads this and writes it into a k8s Secret."
  value       = module.cloudsql.password_secret_id
}
{% endif %}
{% endif %}