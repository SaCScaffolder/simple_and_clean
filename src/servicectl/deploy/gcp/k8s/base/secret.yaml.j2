{% if gcp_postgres_enabled %}# {{ service_id }} — base Secret placeholder.
#
# This is a *placeholder* Secret. The real Secret is created by
# deploy.yml (PR 3) right before `kubectl apply -k`, with the
# value of the postgres password fetched from Secret Manager.
# The bootstrap step is the only safe way to get the password
# into the cluster without committing it to the repo.
#
# Why a placeholder here at all: kustomize resolves Secret
# references at apply time, and the app's Deployment envFrom
# block references this Secret by name. If the Secret doesn't
# exist when the Deployment is applied, the pod stays in
# `CreateContainerConfigError` indefinitely. The placeholder
# gives the bootstrap step something to overwrite.
#
# In the no-postgres path, this file is never rendered (the
# generator gates the whole Secret on `gcp_postgres_enabled`).
apiVersion: v1
kind: Secret
metadata:
  name: db-credentials
  labels:
    app: {{ service_id }}
    managed_by: servicectl
type: Opaque
stringData:
  # deploy.yml (PR 3) does:
  #   kubectl create secret generic db-credentials \
  #     --from-literal=DB_USER=... \
  #     --from-literal=DB_PASSWORD=... \
  #     --from-literal=DB_NAME=... \
  #     --dry-run=client -o yaml | kubectl apply -f -
  # before `kubectl apply -k overlays/<env>`. The placeholder
  # values below are overwritten in-place by the bootstrap step.
  # Without this initial apply, the pod would never come up.
  DB_USER: "PLACEHOLDER_OVERWRITTEN_BY_DEPLOY_WORKFLOW"
  DB_PASSWORD: "PLACEHOLDER_OVERWRITTEN_BY_DEPLOY_WORKFLOW"
  DB_NAME: "PLACEHOLDER_OVERWRITTEN_BY_DEPLOY_WORKFLOW"
{% endif %}
