# {{ service_name }} — base ServiceAccount.
#
# This is the Kubernetes ServiceAccount that the app pod runs as.
# It is annotated with `iam.gke.io/gcp-service-account`, which tells
# GKE Workload Identity to bind the k8s SA to the GCP runtime SA
# (the one that the cloudsql module granted `roles/cloudsql.client`
# to in PR 1). After Workload Identity is set up, the pod can call
# `generateEphemeralCert` on the Cloud SQL Admin API without a
# JSON key.
#
# The k8s-to-GCP binding is done out-of-band (gcloud command) and
# is documented in docs/gke-postgres-setup.md (PR 4). The annotation
# here is the half that lives in the repo.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ service_name }}
  namespace: default
  labels:
    app: {{ service_name }}
    managed_by: servicectl
  annotations:
    iam.gke.io/gcp-service-account: {{ gcp_runtime_sa_email }}
