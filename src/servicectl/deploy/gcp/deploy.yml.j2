name: deploy

on:
  push:
    branches: [main]
  workflow_dispatch:
    inputs:
      environment:
        description: 'Target environment'
        required: true
        default: 'dev'
        type: choice
        options:
          - dev
          - staging
          - prod

env:
  SERVICE_NAME: {{ service_name }}
  IMAGE_NAME: {{ image_name }}

jobs:
  deploy:
    name: deploy to ${{ '{{' }} inputs.environment || 'dev' {{ '}}' }}
    runs-on: ubuntu-latest
    environment:
      name: {% raw %}${{ inputs.environment || 'dev' }}{% endraw %}
    permissions:
      id-token: write   # required for WIF / OIDC federation
      contents: read

    steps:
      - uses: actions/checkout@v4

      - name: Authenticate to Google Cloud (WIF, no JSON keys)
        uses: google-github-actions/auth@v2
        with:
          workload_identity_provider: {% raw %}${{ secrets.GCP_WORKLOAD_IDENTITY_PROVIDER }}{% endraw %}
          service_account: {% raw %}${{ secrets.GCP_SERVICE_ACCOUNT }}{% endraw %}
          project_id: {% raw %}${{ secrets.GCP_PROJECT_ID }}{% endraw %}

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Determine image tag
        id: tag
        run: |
          if [ "${{ '{{' }} github.event_name {{ '}}' }}" = "workflow_dispatch" ]; then
            echo "value=${{ '{{' }} inputs.environment {{ '}}' }}" >> "$GITHUB_OUTPUT"
          else
            echo "value=${GITHUB_SHA::7}" >> "$GITHUB_OUTPUT"
          fi

      - name: Resolve Artifact Registry hostname
        id: ar
        run: |
          REGION="${{ '{{' }} github.event.repository.name {{ '}}' }}"  # placeholder; replaced below
          REGION="${GCP_REGION:-{{ gcp_region }}}"
          PROJECT="{% raw %}${{ secrets.GCP_PROJECT_ID }}{% endraw %}"
          REPO="{{ service_name }}"
          echo "host=${REGION}-docker.pkg.dev" >> "$GITHUB_OUTPUT"
          echo "image=${REGION}-docker.pkg.dev/${PROJECT}/${REPO}/${SERVICE_NAME}" >> "$GITHUB_OUTPUT"

      - name: Build and push image to Artifact Registry
        run: |
          set -euo pipefail
          FULL_IMAGE="${{ '{{' }} steps.ar.outputs.image {{ '}}' }}:${{ '{{' }} steps.tag.outputs.value {{ '}}' }}"
          docker build -t "${FULL_IMAGE}" -t "${FULL_IMAGE%:*}:latest" .
          docker push "${FULL_IMAGE}"
          docker push "${FULL_IMAGE%:*}:latest"
          echo "IMAGE=${FULL_IMAGE}" >> "$GITHUB_ENV"

      - name: Set up Terraform
        uses: hashicorp/setup-terraform@v3
        with:
          terraform_version: 1.6.6

      - name: Terraform init
        working-directory: infra
        run: terraform init -input=false

      - name: Terraform plan
        working-directory: infra
        run: |
          set -euo pipefail
          ENV_FILE="{{ '{{' }} inputs.environment || 'dev' {{ '}}' }}.tfvars"
          terraform plan \
              -var-file="${ENV_FILE}" \
              -var="image=${SERVICE_NAME}" \
              -var="project_id={% raw %}${{ secrets.GCP_PROJECT_ID }}{% endraw %}" \
              -var="region=${GCP_REGION:-{{ gcp_region }}}" \
              -out=tfplan
          echo "PLAN_OK=true" >> "$GITHUB_ENV"

      - name: Terraform apply
        working-directory: infra
        if: {% raw %}${{ github.event_name == 'push' && github.ref == 'refs/heads/main' }}{% endraw %}
        run: terraform apply -input=false -auto-approve tfplan

{% if gcp_gke_autopilot_enabled %}
      - name: Fetch kubeconfig for the Autopilot cluster
        if: {% raw %}${{ github.event_name == 'push' && github.ref == 'refs/heads/main' }}{% endraw %}
        run: |
          set -euo pipefail
          CLUSTER_NAME="$(terraform -chdir=infra output -raw cluster_name)"
          REGION="${GCP_REGION:-{{ gcp_region }}}"
          PROJECT="{% raw %}${{ secrets.GCP_PROJECT_ID }}{% endraw %}"
          gcloud container clusters get-credentials "${CLUSTER_NAME}" \
              --region "${REGION}" --project "${PROJECT}"

{% if gcp_postgres_enabled %}
      - name: Sync db-credentials Secret from Secret Manager
        if: {% raw %}${{ github.event_name == 'push' && github.ref == 'refs/heads/main' }}{% endraw %}
        # The cloudsql module (PR 1) provisions a `random_password` and
        # writes it to Secret Manager. The `db-credentials` k8s Secret is
        # the bridge between Secret Manager and the pod's envFrom; we
        # re-create it on every deploy so a rotated password takes effect
        # on the next push. The placeholder k8s/base/secret.yaml.j2 file
        # (PR 2) is the schema; this step overwrites its stringData.
        run: |
          set -euo pipefail
          SECRET_ID="$(terraform -chdir=infra output -raw db_password_secret_id)"
          DB_NAME="$(terraform -chdir=infra output -raw db_name)"
          DB_USER="$(terraform -chdir=infra output -raw db_user)"
          PASSWORD="$(gcloud secrets versions access latest --secret="${SECRET_ID}" \
              --project="{% raw %}${{ secrets.GCP_PROJECT_ID }}{% endraw %}")"
          kubectl create secret generic db-credentials \
              --from-literal=DB_USER="${DB_USER}" \
              --from-literal=DB_PASSWORD="${PASSWORD}" \
              --from-literal=DB_NAME="${DB_NAME}" \
              --dry-run=client -o yaml | kubectl apply -f -
          echo "db-credentials Secret synced from Secret Manager secret ${SECRET_ID}"
{% endif %}

      - name: kustomize-apply manifests
        if: {% raw %}${{ github.event_name == 'push' && github.ref == 'refs/heads/main' }}{% endraw %}
        run: |
          set -euo pipefail
          ENV="{{ '{{' }} inputs.environment || 'dev' {{ '}}' }}"
          # Inject the freshly-pushed image into the kustomize overlay.
          cd "k8s/overlays/${ENV}"
          kustomize edit set image \
              {{ service_name }}=${{ '{{' }} env.IMAGE {{ '}}' }}
{% if gcp_postgres_enabled %}
          # Same injection for the cloudsql-proxy sidecar. The base
          # kustomization references both <service> and
          # <service>-cloudsql-proxy in its `images:` block, so
          # `kustomize edit set image` only patches the app container.
          # We do the proxy explicitly so its image tag is in lockstep
          # with the app. The proxy image is the same GAR repo with a
          # `-cloudsql-proxy` tag suffix; the proxy Deployment points
          # at gcr.io/cloud-sql-connectors/cloud-sql-proxy:2 by default
          # (see k8s/base/cloudsql-proxy.yaml.j2), so the edit fails
          # silently if the image isn't named the same way.
          kustomize edit set image \
              {{ service_name }}-cloudsql-proxy=${{ '{{' }} env.IMAGE {{ '}}' }}-cloudsql-proxy || true
{% endif %}
          kubectl apply -k .

{% if gcp_postgres_enabled %}
      - name: Run database migrations
        if: {% raw %}${{ github.event_name == 'push' && github.ref == 'refs/heads/main' }}{% endraw %}
        # The `migrate` subcommand in the app binary runs every SQL file
        # under `migrations/` in lexicographic order. It's idempotent
        # (every CREATE uses IF NOT EXISTS), so re-running on every
        # push is safe. We run it via `kubectl exec` against the
        # already-deployed pod so the migrate process has the same
        # DATABASE_URL and the same cloudsql-proxy sidecar that the
        # app uses.
        #
        # This step runs AFTER `kustomize-apply manifests` because
        # `kubectl exec` needs a pod to exist, and the pod only exists
        # after kustomize has created the Deployment. We wait for the
        # pod to be at least schedulable (or Ready) before invoking
        # exec, because the pod's first ~30-60s may be in
        # `ImagePullBackOff` while GAR propagates the freshly-pushed
        # image. The smoke test downstream will hit /healthz
        # (passes even during the GAR wait) and then /readyz (which
        # only goes green once the cloudsql-proxy can reach the
        # Cloud SQL Admin API).
        run: |
          set -euo pipefail
          DEPLOY_NAME="dev-{{ service_name }}"
          # Wait for at least one pod to be Ready (or at least
          # schedulable -- we don't require a successful app
          # readiness, just that the container is up enough for
          # `kubectl exec` to work).
          for i in {1..30}; do
            READY="$(kubectl get deploy "${DEPLOY_NAME}" \
                -o jsonpath='{.status.readyReplicas}' 2>/dev/null || echo "0")"
            if [ "${READY}" != "0" ] && [ -n "${READY}" ]; then
              echo "Deployment has ${READY} ready replica(s) after ${i} attempts"
              break
            fi
            sleep 5
          done
          POD="$(kubectl get pod -l app={{ service_name }} \
              -o jsonpath='{.items[0].metadata.name}' 2>/dev/null || true)"
          if [ -z "${POD}" ]; then
            echo "No pod found for app={{ service_name }}; skipping migrations" >&2
            exit 0
          fi
          echo "Running migrations against pod ${POD}..."
          kubectl exec "${POD}" -- /app/{{ service_name }} migrate
          echo "Migrations complete"
{% endif %}

      - name: Wait for ingress IP and patch overlay with real hostname
        if: {% raw %}${{ github.event_name == 'push' && github.ref == 'refs/heads/main' }}{% endraw %}
        # The GCE Ingress is created on the first `kubectl apply` with
        # the scaffolded placeholder host (`<service>.35.35.35.35.nip.io`).
        # The GCE load balancer takes ~30-90s to provision; once it
        # does, `kubectl get ingress` reports its IP. We patch the
        # overlay's kustomization.yaml to swap the placeholder for the
        # real IP and re-apply. The ManagedCertificate will then issue
        # for the real nip.io hostname.
        #
        # Why sed and not `kustomize edit set hostname`: `kustomize edit`
        # doesn't have a hostname operation, and the host lives inside a
        # JSON6902 patch in overlays/dev/kustomization.yaml. The
        # placeholder `35.35.35.35` is a known constant from the dev
        # overlay's template (service_hostname default), so a single sed
        # substitution is reliable.
        run: |
          set -euo pipefail
          ENV="{{ '{{' }} inputs.environment || 'dev' {{ '}}' }}"
          INGRESS_NAME="dev-{{ service_name }}"
          IP=""
          for i in {1..60}; do
            IP="$(kubectl get ingress "${INGRESS_NAME}" \
                -o jsonpath='{.status.loadBalancer.ingress[0].ip}' 2>/dev/null || true)"
            if [ -n "${IP}" ] && [ "${IP}" != "null" ]; then
              echo "Ingress IP is ${IP} (after ${i} attempts)"
              break
            fi
            sleep 5
          done
          if [ -z "${IP}" ] || [ "${IP}" = "null" ]; then
            echo "GCE load balancer did not provision an IP within 5 minutes" >&2
            echo "Falling back to placeholder host; ManagedCertificate will not issue" >&2
            exit 0
          fi
          sed -i "s/35\.35\.35\.35/${IP}/g" "k8s/overlays/${ENV}/kustomization.yaml"
          kubectl apply -k "k8s/overlays/${ENV}"
          echo "Overlay patched with real ingress IP ${IP}"
{% endif %}

      - name: Smoke test
        if: {% raw %}${{ github.event_name == 'push' && github.ref == 'refs/heads/main' }}{% endraw %}
        run: |
          set -euo pipefail
{% if gcp_cloud_run_enabled %}
          URL="$(terraform -chdir=infra output -raw service_url)"
{% elif gcp_gke_autopilot_enabled %}
          URL="$(kubectl get svc -l app={{ service_name }} -o jsonpath='{.items[0].status.loadBalancer.ingress[0].ip}' 2>/dev/null || true)"
          if [ -z "$URL" ]; then
            URL="$(kubectl get svc -l app={{ service_name }} -o jsonpath='{.items[0].spec.clusterIP}')"
            echo "No external LB; falling back to in-cluster health check via port-forward"
            kubectl port-forward svc/{{ service_name }} 8080:80 &
            PF_PID=$!
            sleep 5
            for i in {1..30}; do
              if curl -sf "http://localhost:8080/healthz" >/dev/null; then
                echo "Health check passed after ${i} attempts"
                kill $PF_PID 2>/dev/null || true
                exit 0
              fi
              sleep 5
            done
            kill $PF_PID 2>/dev/null || true
            echo "Health check failed after 5 minutes" >&2
            exit 1
          fi
{% endif %}
          for i in {1..30}; do
            if curl -sf "https://${URL}/healthz" >/dev/null; then
              echo "Health check passed after ${i} attempts"
{% if gcp_postgres_enabled %}
              # /readyz returns 200 only when the dependency checks pass
              # (including the DB ping through the cloudsql-proxy). It
              # can take a few extra seconds after /healthz to come up
              # because the proxy has to negotiate a TLS cert with the
              # Cloud SQL Admin API. We poll /readyz for up to 2 minutes;
              # a failure here is a soft warning, not a deploy failure,
              # because the pod is up and serving traffic either way.
              READYZ_OK=false
              for j in {1..12}; do
                if curl -sf "https://${URL}/readyz" >/dev/null; then
                  echo "Readyz check passed after ${j} attempts (DB reachable)"
                  READYZ_OK=true
                  break
                fi
                sleep 10
              done
              if [ "${READYZ_OK}" = "false" ]; then
                echo "::warning::Readyz did not return 200 within 2 minutes; the DB may not be reachable from the cloudsql-proxy. The deploy itself succeeded; investigate the proxy and the Workload Identity binding." >&2
              fi
              # Now that /readyz is green, the DB is reachable end-to-end.
              # POST a note, then GET the list and assert the note is in
              # the response. This is the real signal that the full
              # stack (app -> cloudsql-proxy -> Cloud SQL) is wired up,
              # not just that the proxy can talk to the Admin API.
              NOTE_BODY="hello-from-deploy-$(date +%s)"
              CREATED_ID="$(curl -sf -X POST -H 'Content-Type: application/json' \
                  -d "{\"body\":\"${NOTE_BODY}\"}" \
                  "https://${URL}/notes" | jq -r '.id')"
              if [ -z "${CREATED_ID}" ] || [ "${CREATED_ID}" = "null" ]; then
                echo "::warning::POST /notes did not return an id; DB writes are not working. The deploy itself succeeded; investigate the proxy connection." >&2
              else
                LISTED="$(curl -sf "https://${URL}/notes" | jq -r --arg id "${CREATED_ID}" '.[] | select(.id == ($id | tonumber)) | .body')"
                if [ "${LISTED}" = "${NOTE_BODY}" ]; then
                  echo "DB round-trip ok: POST /notes created id=${CREATED_ID}, GET /notes returned the same body"
                else
                  echo "::warning::GET /notes did not return the POSTed body (id=${CREATED_ID}); DB round-trip failed" >&2
                fi
              fi
{% endif %}
              exit 0
            fi
            sleep 10
          done
          echo "Health check failed after 5 minutes" >&2
          exit 1