name: ci

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

# IMAGE_NAME is set in the "Set image name" step at the top of
# each job that needs it (build, publish). We can't use a GitHub
# Actions expression function to lowercase github.repository_owner
# — there is no such function — so we compute it in shell and
# write to $GITHUB_ENV. This matters for mixed-case org names
# like SaCScaffolder; Docker requires lowercase repo names.

env:
  DOTNET_VERSION: "8.0.x"

jobs:
  test:
    name: build + test
    runs-on: ubuntu-latest
    services:
      postgres:
        image: postgres:16-alpine
        env:
          POSTGRES_DB: {{ service_name }}_test
          POSTGRES_USER: postgres
          POSTGRES_PASSWORD: postgres
        ports:
          - 5432:5432
        options: >-
          --health-cmd "pg_isready -U postgres"
          --health-interval 5s
          --health-timeout 5s
          --health-retries 5
    env:
      ConnectionStrings__Postgres: "Host=localhost;Port=5432;Database={{ service_name }}_test;Username=postgres;Password=postgres"
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-dotnet@v4
        with:
          dotnet-version: {% raw %}${{ env.DOTNET_VERSION }}{% endraw %}
      - run: dotnet restore
      - run: dotnet build --no-restore --configuration Release
      - run: dotnet test --no-build --configuration Release --collect:"XPlat Code Coverage" -- DataCollectionRunSettings.DataCollectors.DataCollector.Configuration.Format=cobertura /p:Threshold={{ coverage_threshold }}
      - name: Upload coverage
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: coverage
          path: '**/TestResults/**/coverage.cobertura.xml'

  build:
    name: build + scan
    runs-on: ubuntu-latest
    needs: test
    permissions:
      contents: read
      packages: write
    steps:
      - name: Set image name
        run: |
          {% raw %}OWNER=$(echo "${{ github.repository_owner }}" | tr '[:upper:]' '[:lower:]')
          REPO=$(echo "${{ github.event.repository.name }}" | tr '[:upper:]' '[:lower:]'){% endraw %}
          echo "IMAGE_NAME={{ registry_hostname }}/${OWNER}/${REPO}" >> "$GITHUB_ENV"
      - uses: actions/checkout@v4
      - uses: actions/setup-dotnet@v4
        with:
          dotnet-version: {% raw %}${{ env.DOTNET_VERSION }}{% endraw %}
      - run: dotnet publish -c Release -o /tmp/publish --no-restore
      - name: Build image
        run: |
          {% raw %}docker build -t $IMAGE_NAME:${{ github.sha }} .{% endraw %}
      - name: Scan image (Trivy)
        uses: aquasecurity/trivy-action@0.20.0
        with:
          image-ref: {% raw %}$IMAGE_NAME:${{ github.sha }}{% endraw %}
          severity: HIGH,CRITICAL
          exit-code: "1"
          ignore-unfixed: true
{% if ci_provider == 'github-actions' %}
  publish:
    name: publish
    runs-on: ubuntu-latest
    needs: [test, build]
    if: {% raw %}github.event_name == 'push' && github.ref == 'refs/heads/main'{% endraw %}
    # The publish job pushes to {{ registry_hostname }} with GITHUB_TOKEN.
    # The image is in the current repo's own package namespace (see
    # "Set image name" step), so GITHUB_TOKEN's repo-level packages: write
    # covers the push. We still keep contents: read for checkout (no
    # code is written back).
    permissions:
      contents: read
      packages: write
    steps:
      - name: Set image name
        run: |
          {% raw %}OWNER=$(echo "${{ github.repository_owner }}" | tr '[:upper:]' '[:lower:]')
          REPO=$(echo "${{ github.event.repository.name }}" | tr '[:upper:]' '[:lower:]'){% endraw %}
          echo "IMAGE_NAME={{ registry_hostname }}/${OWNER}/${REPO}" >> "$GITHUB_ENV"
      - uses: actions/checkout@v4
      # Log in to {{ registry }} with the workflow's GITHUB_TOKEN. The
      # image is in the current repo's own package namespace (see
      # "Set image name" step), so GITHUB_TOKEN's repo-level
      # packages: write covers the push. This is the standard
      # GitHub-supported way to push to ghcr.io -- the docs note that
      # GitHub Packages only supports authentication using a personal
      # access token (classic) or GITHUB_TOKEN, not GitHub App
      # installation tokens
      # (https://docs.github.com/en/packages/working-with-a-github-packages-registry/working-with-the-container-registry).
      # The org's "Workflow permissions" setting must be "Read and
      # write" for GITHUB_TOKEN to carry that scope.
      - uses: docker/login-action@v3
        with:
          registry: {{ registry }}
          username: {% raw %}${{ github.actor }}{% endraw %}
          password: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
      - name: Push image
        run: |
          {% raw %}docker tag $IMAGE_NAME:${{ github.sha }} $IMAGE_NAME:latest
          docker push $IMAGE_NAME:${{ github.sha }}
          docker push $IMAGE_NAME:latest{% endraw %}
{% endif %}
