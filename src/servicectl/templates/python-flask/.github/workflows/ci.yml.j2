name: ci

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

env:
  # IMAGE_NAME is set in the "Set image name" step at the top of
  # each job that needs it (build, publish). We can't use a GitHub
  # Actions expression function to lowercase github.repository_owner
  # — there is no such function — so we compute it in shell and
  # write to $GITHUB_ENV. This matters for mixed-case org names
  # like SaCScaffolder; Docker requires lowercase repo names.

jobs:
  test:
    name: lint + test
    runs-on: ubuntu-latest
    services:
      postgres:
        image: postgres:16-alpine
        env:
          POSTGRES_DB: {{ service_name }}_test
          POSTGRES_USER: postgres
          POSTGRES_PASSWORD: postgres
        ports:
          - 5432:5432
        options: >-
          --health-cmd "pg_isready -U postgres"
          --health-interval 5s
          --health-timeout 5s
          --health-retries 5
    env:
      POSTGRES_HOST: localhost
      POSTGRES_PORT: 5432
      POSTGRES_DB: {{ service_name }}_test
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip
      - run: pip install -e ".[dev]"
      - run: ruff check .
      - run: pytest
      - name: Upload coverage
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: coverage
          path: .coverage,htmlcov/

  build:
    name: build + scan
    runs-on: ubuntu-latest
    needs: test
    permissions:
      contents: read
      packages: write
    steps:
      - name: Set image name
        run: |
          {% raw %}OWNER=$(echo "${{ github.repository_owner }}" | tr '[:upper:]' '[:lower:]'){% endraw %}
          echo "IMAGE_NAME={{ registry_hostname }}/${OWNER}/{{ service_name }}" >> "$GITHUB_ENV"
      - uses: actions/checkout@v4
      - name: Build image
        run: {% raw %}docker build -t $IMAGE_NAME:${{ github.sha }} .{% endraw %}
      - name: Scan image (Trivy)
        uses: aquasecurity/trivy-action@0.20.0
        with:
          image-ref: {% raw %}$IMAGE_NAME:${{ github.sha }}{% endraw %}
          severity: HIGH,CRITICAL
          exit-code: "1"
          ignore-unfixed: true
{% if ci_provider == 'github-actions' %}
  publish:
    name: publish
    runs-on: ubuntu-latest
    needs: [test, build]
    if: {% raw %}github.event_name == 'push' && github.ref == 'refs/heads/main'{% endraw %}
    permissions:
      contents: read
      packages: write
    steps:
      - name: Set image name
        run: |
          {% raw %}OWNER=$(echo "${{ github.repository_owner }}" | tr '[:upper:]' '[:lower:]'){% endraw %}
          echo "IMAGE_NAME={{ registry_hostname }}/${OWNER}/{{ service_name }}" >> "$GITHUB_ENV"
      - uses: actions/checkout@v4
      - uses: docker/login-action@v3
        with:
          registry: {{ registry }}
          username: {% raw %}${{ github.actor }}{% endraw %}
          password: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
      - name: Push image
        run: |
          {% raw %}docker tag $IMAGE_NAME:${{ github.sha }} $IMAGE_NAME:latest
          docker push $IMAGE_NAME:${{ github.sha }}
          docker push $IMAGE_NAME:latest{% endraw %}
{% endif %}
