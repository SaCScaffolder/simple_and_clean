#!/usr/bin/env bash
# Pre-commit hook: run the language-appropriate smoke test for {{ service_name }}
# AND enforce the coverage gate. Generated by servicectl.
#
# Why: catches regressions like the commit 5808d00 / 567509f template fixes
# landing without a corresponding test update, which broke CI on push.
# Running the smoke test pre-commit is ~1-3s on a warm cache and gives the
# author the same signal CI will give on push, before the public history
# is touched.
#
# To install (one-time per clone):
#   git config core.hooksPath .githooks
#
# To bypass in an emergency (e.g., WIP commit):
#   git commit --no-verify -m "..."

set -euo pipefail

# Find a python interpreter (used to run python smoke tests if applicable).
if command -v python3 >/dev/null 2>&1; then
  PYTHON=python3
elif command -v python >/dev/null 2>&1; then
  PYTHON=python
elif command -v py >/dev/null 2>&1; then
  PYTHON=py
else
  PYTHON=""
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "==> running smoke tests (pre-commit hook for {{ service_name }}, template={{ template }}) ..."

{% if template == "go-webapi" %}
# Go service: run vet + tests with race + coverage gate.
go vet ./...
go test -race -coverprofile=coverage.out ./...

# Coverage gate. Default to 80% if not configured. Adjust in pyproject.toml
# or .githooks/pre-commit as needed.
THRESHOLD=${COVERAGE_THRESHOLD:-80}
TOTAL=$(go tool cover -func=coverage.out | awk '/^total:/ {print substr($3, 1, length($3)-1)}')
echo "==> total coverage: ${TOTAL}% (threshold: ${THRESHOLD}%)"
awk -v want="$THRESHOLD" -v got="$TOTAL" 'BEGIN { if (got+0 < want+0) { printf("FAIL: coverage is %s%%, threshold is %s%%\n", got, want); exit 1 } }'

{% elif template == "node-express" or template == "node-react-web" %}
# Node service: run lint + typecheck (where present) + tests with coverage gate.
if [ -f package.json ]; then
  if npm run | grep -qE '^  lint$'; then
    npm run lint
  fi
  if npm run | grep -qE '^  typecheck$'; then
    npm run typecheck
  fi
  # Coverage gate. The Node template is configured for vitest which writes
  # coverage to ./coverage after `npm test` with --coverage. The vitest config
  # (vitest.config.ts) sets the threshold; we surface it here.
  npm test
  THRESHOLD=${COVERAGE_THRESHOLD:-80}
  if [ -f coverage/coverage-summary.json ]; then
    PCT=$(python -c "import json; d=json.load(open('coverage/coverage-summary.json')); print(int(d['total']['lines']['pct']))" 2>/dev/null || echo "0")
    echo "==> total coverage: ${PCT}% (threshold: ${THRESHOLD}%)"
    awk -v want="$THRESHOLD" -v got="$PCT" 'BEGIN { if (got+0 < want+0) { printf("FAIL: coverage is %s%%, threshold is %s%%\n", got, want); exit 1 } }'
  else
    echo "==> WARNING: no coverage/coverage-summary.json found; skipping coverage gate."
  fi
fi

{% elif template == "python-flask" %}
# Python service: run pytest with coverage gate.
if [ -n "$PYTHON" ] && [ -f pyproject.toml ]; then
  THRESHOLD=${COVERAGE_THRESHOLD:-80}
  COVERAGE_THRESHOLD="$THRESHOLD" $PYTHON -m pytest -q
fi

{% elif template == "dotnet-webapi" %}
# .NET service: run dotnet test with coverage gate (Threshold from csproj).
dotnet test --nologo
{% endif %}

echo "==> smoke tests passed and coverage threshold met."