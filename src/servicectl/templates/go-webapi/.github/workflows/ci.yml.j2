name: ci

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

# Top-level permissions: grants GITHUB_TOKEN the rights it needs across
# every job. The publish job pushes to {{ registry_hostname }} — that
# push uses an App installation token (minted in the publish job
# itself), NOT GITHUB_TOKEN, because GITHUB_TOKEN's packages: write
# is repo-scoped and the image is in the org's package namespace.
# So we keep the GITHUB_TOKEN scope minimal: just contents: read
# for checkouts.
permissions:
  contents: read

# IMAGE_NAME is set in the "Set image name" step at the top of
# each job that needs it (build, publish). We can't use a GitHub
# Actions expression function to lowercase github.repository_owner
# — there is no such function — so we compute it in shell and
# write to $GITHUB_ENV. This matters for mixed-case org names
# like SaCScaffolder; Docker requires lowercase repo names.

jobs:
  test:
    name: vet + test
    runs-on: ubuntu-latest
    env:
      POSTGRES_HOST: localhost
      POSTGRES_PORT: 5432
      POSTGRES_DB: {{ service_name }}_test
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
    services:
      postgres:
        image: postgres:16-alpine
        env:
          POSTGRES_DB: {{ service_name }}_test
          POSTGRES_USER: postgres
          POSTGRES_PASSWORD: postgres
        ports:
          - 5432:5432
        options: >-
          --health-cmd "pg_isready -U postgres"
          --health-interval 5s
          --health-timeout 5s
          --health-retries 5
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version: "1.22"
          cache-dependency-path: go.sum
      - name: go mod download
        run: go mod download
      - name: go vet
        run: go vet ./...
      - name: go test (with coverage)
        run: |
          go test ./... -count=1 -race -coverprofile=coverage.out -covermode=atomic
          # Coverage gate. Adjust to taste; {{ coverage_threshold }}% is the default.
          COVERAGE=$(go tool cover -func=coverage.out | awk '/^total:/ {print substr($3, 1, length($3)-1)}')
          echo "total coverage: ${COVERAGE}%"
          awk -v want={{ coverage_threshold }} -v got="$COVERAGE" 'BEGIN { if (got+0 < want+0) { exit 1 } }'
      - name: Upload coverage
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: coverage
          path: coverage.out

  build:
    name: build + scan
    runs-on: ubuntu-latest
    needs: test
    steps:
      - name: Set image name
        run: |
          {% raw %}OWNER=$(echo "${{ github.repository_owner }}" | tr '[:upper:]' '[:lower:]'){% endraw %}
          echo "IMAGE_NAME={{ registry_hostname }}/${OWNER}/{{ service_name }}" >> "$GITHUB_ENV"
      - uses: actions/checkout@v4
      - name: Build image
        run: {% raw %}docker build -t $IMAGE_NAME:${{ github.sha }} .{% endraw %}
      - name: Scan image (Trivy)
        uses: aquasecurity/trivy-action@v0.36.0
        with:
{% raw %}          # Use ${{ env.IMAGE_NAME }} instead of $IMAGE_NAME so GitHub
          # Actions expands the env var. The bare `$VAR` form only works
          # in `run:` blocks; in `with:` values it stays literal and
          # trivy fails with "could not parse reference".
          image-ref: ${{ env.IMAGE_NAME }}:${{ github.sha }}{% endraw %}
          severity: HIGH,CRITICAL
          exit-code: "1"
          ignore-unfixed: true
{% if ci_provider == 'github-actions' %}
  publish:
    name: publish
    runs-on: ubuntu-latest
    needs: [test, build]
    if: {% raw %}github.event_name == 'push' && github.ref == 'refs/heads/main'{% endraw %}
    steps:
      - name: Set image name
        run: |
          {% raw %}OWNER=$(echo "${{ github.repository_owner }}" | tr '[:upper:]' '[:lower:]'){% endraw %}
          echo "IMAGE_NAME={{ registry_hostname }}/${OWNER}/{{ service_name }}" >> "$GITHUB_ENV"
      - uses: actions/checkout@v4
      # Build AND push in one job so the image is available on this runner.
      # The earlier design built in the `build` step and tried to push from a
      # separate `publish` job, but cross-runner Docker image handoff isn't
      # supported — the image doesn't exist on a fresh runner.

      # Mint an App installation token for the docker login. The App
      # has org-level packages: write (it's installed on the org),
      # so the token can push to {{ registry_hostname }}/<org>/<image>
      # from any repo in the org. GITHUB_TOKEN's packages: write is
      # repo-level and only authorizes pushing to packages in the
      # *current repo's* namespace — which is not where the image
      # lives (the image name is the service name, not the repo name).
      # Verified failure: see MEMORY note for run 37835587188
      # (2026-10-08), where the canonical example's publish step
      # failed with `permission_denied: write_package` because the
      # scaffolded ci.yml used a GITHUB_TOKEN-based password.
      #
      # APP_ID and APP_PRIVATE_KEY are expected to be available as
      # org-level secrets (preferred — inherited by every repo
      # including the per-PR `_pr_<n>` repos the integration test
      # creates) or as repo-level secrets on every scaffolded repo.
      - name: Mint installation token from GitHub App
        id: app-token
        uses: actions/create-github-app-token@v1
        with:
          app-id: {% raw %}${{ secrets.APP_ID }}{% endraw %}
          private-key: {% raw %}${{ secrets.APP_PRIVATE_KEY }}{% endraw %}
          owner: {% raw %}${{ github.repository_owner }}{% endraw %}
      - name: Log in to {{ registry_hostname }}
        uses: docker/login-action@v3
        with:
          registry: {{ registry_hostname }}
          username: {% raw %}${{ github.actor }}{% endraw %}
          password: {% raw %}${{ steps.app-token.outputs.token }}{% endraw %}
      - name: Build and push
        uses: docker/build-push-action@v5
        with:
          context: .
          push: true
          tags: |
            {% raw %}${{ env.IMAGE_NAME }}:${{ github.sha }}
            ${{ env.IMAGE_NAME }}:latest{% endraw %}
{% endif %}