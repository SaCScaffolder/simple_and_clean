// TestNotesPostgresRoundTrip POSTs a unique note and asserts it shows
// up in GET /notes. Covers the createNote + listNotes success paths
// end-to-end.
func TestNotesPostgresRoundTrip(t *testing.T) {
	db := openTestDB(t)
	srv := NewServer(db)

	prefix := fmt.Sprintf("roundtrip-%d", time.Now().UnixNano())
	body := uniqueBody(prefix)

	// POST /notes
	postRec := httptest.NewRecorder()
	postReq := httptest.NewRequest(http.MethodPost, "/notes",
		strings.NewReader(fmt.Sprintf(`{"body":%q}`, body)))
	srv.Mux().ServeHTTP(postRec, postReq)
	if postRec.Code != http.StatusCreated {
		t.Fatalf("POST /notes: expected 201, got %d (body=%s)", postRec.Code, postRec.Body.String())
	}
	var created Note
	if err := json.NewDecoder(postRec.Body).Decode(&created); err != nil {
		t.Fatalf("decode created note: %v", err)
	}
	if created.Body != body {
		t.Fatalf("expected created.Body=%q, got %q", body, created.Body)
	}
	if created.ID == 0 {
		t.Fatal("expected non-zero ID on created note")
	}

	// GET /notes -- assert our note is in the list
	got, ok := lastNoteWithBody(t, srv, prefix)
	if !ok {
		t.Fatalf("POSTed note with prefix %q not found in GET /notes", prefix)
	}
	if got.ID != created.ID {
		t.Fatalf("expected ID=%d, got %d", created.ID, got.ID)
	}
	if got.Body != body {
		t.Fatalf("expected Body=%q, got %q", body, got.Body)
	}
}

// TestNotesPostgresValidation exercises the 400-paths on POST /notes:
// empty body, body too long, malformed JSON. The validation happens
// before any SQL, so we don't need a real DB for the early-return
// cases, but using NewServer(db) makes the test honest about the
// real call shape.
func TestNotesPostgresValidation(t *testing.T) {
	db := openTestDB(t)
	srv := NewServer(db)

	cases := []struct {
		name string
		body string
	}{
		{"empty body", `{"body":""}`},
		{"body too long", fmt.Sprintf(`{"body":%q}`, strings.Repeat("x", 1025))},
		{"malformed JSON", `{"body": this is not json}`},
		{"missing body field", `{}`},
	}
	for _, tc := range cases {
		t.Run(tc.name, func(t *testing.T) {
			rec := httptest.NewRecorder()
			req := httptest.NewRequest(http.MethodPost, "/notes", strings.NewReader(tc.body))
			srv.Mux().ServeHTTP(rec, req)
			if rec.Code != http.StatusBadRequest {
				t.Errorf("expected 400 for %q, got %d (body=%s)", tc.name, rec.Code, rec.Body.String())
			}
		})
	}
}

// TestNotesPostgresMethodNotAllowed exercises the 405-path on /notes.
// PUT, DELETE, and PATCH on /notes all return 405 with an Allow header
// of "GET, POST".
func TestNotesPostgresMethodNotAllowed(t *testing.T) {
	db := openTestDB(t)
	srv := NewServer(db)

	for _, method := range []string{http.MethodPut, http.MethodDelete, http.MethodPatch} {
		t.Run(method, func(t *testing.T) {
			rec := httptest.NewRecorder()
			req := httptest.NewRequest(method, "/notes", nil)
			srv.Mux().ServeHTTP(rec, req)
			if rec.Code != http.StatusMethodNotAllowed {
				t.Errorf("expected 405 for %s, got %d", method, rec.Code)
			}
			if got := rec.Header().Get("Allow"); got != "GET, POST" {
				t.Errorf("expected Allow=%q, got %q", "GET, POST", got)
			}
		})
	}
}

