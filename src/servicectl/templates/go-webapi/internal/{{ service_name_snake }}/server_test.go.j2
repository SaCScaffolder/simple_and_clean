		t.Fatalf("expected status=ready, got %q", body["status"])
	}
}

// TestReadyzWithClosedDB verifies /readyz returns 503 when the
// configured DB has been closed. Exercises the ping-failure path.
func TestReadyzWithClosedDB(t *testing.T) {
	db := openTestDB(t)
	db.Close() // force ping to fail
	srv := NewServer(db)

	rec := httptest.NewRecorder()
	req := httptest.NewRequest(http.MethodGet, "/readyz", nil)
	srv.Mux().ServeHTTP(rec, req)

	if rec.Code != http.StatusServiceUnavailable {
		t.Fatalf("expected 503 with closed DB, got %d (body=%s)", rec.Code, rec.Body.String())
	}
	var body map[string]string
	if err := json.NewDecoder(rec.Body).Decode(&body); err != nil {
		t.Fatalf("decode body: %v", err)
	}
	if body["status"] != "not_ready" {
		t.Fatalf("expected status=not_ready, got %q", body["status"])
	}
	if body["reason"] != "db_ping_failed" {
		t.Fatalf("expected reason=db_ping_failed, got %q", body["reason"])
	}
}

