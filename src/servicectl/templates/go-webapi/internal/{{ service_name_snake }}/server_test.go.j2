//
// --- postgres-path tests (--db=postgres only) ----------------------------
//
// These tests cover the *sql.DB code paths in server.go.j2. They require
// a real postgres database; the CI workflow (ci.yml.j2) provisions one
// via a `services: postgres:` block with the POSTGRES_* env vars set.
// If POSTGRES_HOST is unset (e.g. running the tests locally without
// docker), the tests are skipped -- not failed -- so the test suite
// remains runnable in any environment.
//

// openTestDB returns a *sql.DB connected to the test postgres instance,
// or skips the test if POSTGRES_HOST is unset. The connection is closed
// automatically via t.Cleanup.
func openTestDB(t *testing.T) *sql.DB {
	t.Helper()
	if os.Getenv("POSTGRES_HOST") == "" {
		t.Skip("POSTGRES_HOST not set; skipping postgres-dependent test")
	}
	dsn := fmt.Sprintf(
		"host=%s port=%s user=%s password=%s dbname=%s sslmode=disable",
		os.Getenv("POSTGRES_HOST"),
		getenv("POSTGRES_PORT", "5432"),
		os.Getenv("POSTGRES_USER"),
		os.Getenv("POSTGRES_PASSWORD"),
		os.Getenv("POSTGRES_DB"),
	)
	db, err := sql.Open("pgx", dsn)
	if err != nil {
		t.Fatalf("sql.Open: %v", err)
	}
	// Confirm the DB is actually reachable. sql.Open is lazy.
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()
	if err := db.PingContext(ctx); err != nil {
		db.Close()
		t.Fatalf("ping test postgres: %v", err)
	}
	t.Cleanup(func() { db.Close() })
	return db
}

// getenv is os.Getenv with a default. Tiny helper to avoid the
// `if x == "" { x = "5432" }` boilerplate at every call site.
func getenv(key, def string) string {
	if v := os.Getenv(key); v != "" {
		return v
	}
	return def
}

// uniqueBody returns a body string that's unique per call, so tests
// that POST notes don't collide on the shared test database. The
// prefix lets the test filter the GET /notes response to just the
// notes it created.
func uniqueBody(prefix string) string {
	return fmt.Sprintf("%s-%d", prefix, time.Now().UnixNano())
}

// lastNoteWithBody fetches the most recent notes via GET /notes and
// returns the first one whose body has the given prefix. Returns
// (nil, false) if no match. Used by round-trip tests to assert
// "the note I just POSTed shows up in the list".
func lastNoteWithBody(t *testing.T, srv *Server, prefix string) (*Note, bool) {
	t.Helper()
	rec := httptest.NewRecorder()
	req := httptest.NewRequest(http.MethodGet, "/notes", nil)
	srv.Mux().ServeHTTP(rec, req)
	if rec.Code != http.StatusOK {
		t.Fatalf("GET /notes: expected 200, got %d (body=%s)", rec.Code, rec.Body.String())
	}
	var notes []Note
	if err := json.NewDecoder(rec.Body).Decode(&notes); err != nil {
		t.Fatalf("decode notes: %v", err)
	}
	for i := range notes {
		if strings.HasPrefix(notes[i].Body, prefix) {
			return &notes[i], true
		}
	}
	return nil, false
}

// TestReadyzWithDB verifies /readyz returns 200 when the configured DB
// is reachable. Companion to TestReadyz (which tests the no-DB path).
func TestReadyzWithDB(t *testing.T) {
	db := openTestDB(t)
	srv := NewServer(db)

	rec := httptest.NewRecorder()
	req := httptest.NewRequest(http.MethodGet, "/readyz", nil)
	srv.Mux().ServeHTTP(rec, req)

	if rec.Code != http.StatusOK {
		t.Fatalf("expected 200 with reachable DB, got %d (body=%s)", rec.Code, rec.Body.String())
	}
	var body map[string]string
	if err := json.NewDecoder(rec.Body).Decode(&body); err != nil {
		t.Fatalf("decode body: %v", err)
	}
