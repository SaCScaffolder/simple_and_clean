// TestRunMigrations verifies RunMigrations creates the notes table
// and is idempotent (re-running is a no-op). This is the test
// counterpart to the `migrate` subcommand in cmd/server.
func TestRunMigrations(t *testing.T) {
	db := openTestDB(t)
	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()

	// First run: should create the table. If a previous test run
	// already created it, IF NOT EXISTS makes this a no-op.
	if err := RunMigrations(ctx, db); err != nil {
		t.Fatalf("first RunMigrations: %v", err)
	}

	// Verify the table exists by querying pg_tables.
	var exists bool
	row := db.QueryRowContext(ctx,
		`SELECT EXISTS (SELECT 1 FROM pg_tables WHERE tablename = 'notes')`)
	if err := row.Scan(&exists); err != nil {
		t.Fatalf("query pg_tables: %v", err)
	}
	if !exists {
		t.Fatal("expected `notes` table to exist after RunMigrations")
	}

	// Second run: must be a no-op (idempotent).
	if err := RunMigrations(ctx, db); err != nil {
		t.Fatalf("second RunMigrations (idempotent): %v", err)
	}

	// Third sanity: the index from migration001Notes should also exist.
	var indexExists bool
	row = db.QueryRowContext(ctx,
		`SELECT EXISTS (SELECT 1 FROM pg_indexes
		 WHERE indexname = 'notes_created_at_idx')`)
	if err := row.Scan(&indexExists); err != nil {
		t.Fatalf("query pg_indexes: %v", err)
	}
	if !indexExists {
		t.Fatal("expected `notes_created_at_idx` index to exist after RunMigrations")
	}
}

// TestRunMigrationsBadDB verifies RunMigrations returns a non-nil
// error when the DB is closed. Exercises the error path that
// main.go's runMigrate surfaces via log.Fatalf.
func TestRunMigrationsBadDB(t *testing.T) {
	db := openTestDB(t)
	db.Close()
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()
	err := RunMigrations(ctx, db)
	if err == nil {
		t.Fatal("expected error from RunMigrations with closed DB, got nil")
	}
	// Sanity: the error should reference the file name so the user
	// can find the failing migration.
	if !strings.Contains(err.Error(), "001_notes.sql") {
		t.Errorf("expected error to mention 001_notes.sql, got: %v", err)
	}
}

// _ = errors.New keeps the import used in TestRunMigrationsBadDB's
// callers (the runMigrate path in main.go uses errors.New directly;
// the import is here for forward-compat if a test needs it).
var _ = errors.New
