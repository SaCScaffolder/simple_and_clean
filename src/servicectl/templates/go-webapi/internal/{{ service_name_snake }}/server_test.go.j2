// TestRoutesExist is a table-driven check that the scaffold's expected
// routes are registered. Add new routes to the table when you add handlers.
func TestRoutesExist(t *testing.T) {
	srv := NewServer(nil)
	mux := srv.Mux()

	routes := []struct {
		method string
		path   string
	}{
		{http.MethodGet, "/healthz"},
		{http.MethodGet, "/readyz"},
		{http.MethodGet, "/"},
{% if db == "postgres" %}
		{http.MethodGet, "/notes"},
{% endif %}
	}

	for _, r := range routes {
		rec := httptest.NewRecorder()
		req := httptest.NewRequest(r.method, r.path, nil)
		mux.ServeHTTP(rec, req)

		// /notes with no DB returns 503; for the table-driven check
		// we accept either 200 (no-DB routes) or 503 (/notes with
		// no DB). The real assertion for /notes is in
		// TestNotesPostgresNoDB below.
{% if db == "postgres" %}
		if r.path == "/notes" && rec.Code != http.StatusServiceUnavailable {
			t.Errorf("route %s %s: expected 503 (no DB), got %d", r.method, r.path, rec.Code)
			continue
		}
{% endif %}
		if rec.Code != http.StatusOK {
			t.Errorf("route %s %s: expected 200, got %d", r.method, r.path, rec.Code)
		}
	}
}
