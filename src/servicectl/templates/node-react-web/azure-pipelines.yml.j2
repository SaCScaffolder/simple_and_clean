# Azure DevOps pipeline for {{ service_name }}
# Generated by servicectl. Edit as needed.

trigger:
  branches:
    include:
      - main

pr:
  branches:
    include:
      - main

variables:
  imageName: '{{ registry }}/{{ service_name }}'
  tag: $(Build.BuildId)
  VITE_API_BASE_URL: '/api'

stages:
  - stage: test
    displayName: lint + test
    jobs:
      - job: test
        displayName: test
        pool:
          vmImage: ubuntu-latest
        steps:
          - checkout: self
          - task: NodeTool@0
            inputs:
              versionSpec: "20.x"
          - script: npm ci --no-audit --no-fund
            displayName: npm ci
          - script: npm run typecheck
            displayName: typecheck
          - script: npm run lint
            displayName: lint
          - script: |
              npm test
              COVERAGE=$(cat coverage/coverage-summary.json | jq '.total.lines.pct')
              echo "total line coverage: ${COVERAGE}%"
              awk -v want={{ coverage_threshold }} -v got="$COVERAGE" 'BEGIN { if (got+0 < want+0) { exit 1 } }'
            displayName: test (coverage gate {{ coverage_threshold }}%)
          - task: PublishCodeCoverageResults@2
            condition: always()
            inputs:
              summaryFileLocation: "$(System.DefaultWorkingDirectory)/coverage/cobertura-coverage.xml"

  - stage: build
    displayName: build + scan
    dependsOn: test
    jobs:
      - job: build
        displayName: build
        pool:
          vmImage: ubuntu-latest
        steps:
          - checkout: self
          - script: docker build --build-arg VITE_API_BASE_URL=$(VITE_API_BASE_URL) -t $(imageName):$(tag) .
            displayName: docker build
          - script: |
              docker run --rm -v /var/run/docker.sock:/var/run/docker.sock \
                aquasec/trivy:latest image --exit-code 1 --severity HIGH,CRITICAL \
                $(imageName):$(tag)
            displayName: trivy scan

{% if ci_provider == 'azure-devops' %}
  - stage: publish
    displayName: publish
    dependsOn: [test, build]
    condition: and(succeeded(), eq(variables['Build.SourceBranch'], 'refs/heads/main'))
    jobs:
      - job: publish
        displayName: publish
        pool:
          vmImage: ubuntu-latest
        steps:
          - checkout: self
          - script: |
              docker tag $(imageName):$(tag) $(imageName):latest
              docker push $(imageName):$(tag)
              docker push $(imageName):latest
            displayName: push image
{% endif %}