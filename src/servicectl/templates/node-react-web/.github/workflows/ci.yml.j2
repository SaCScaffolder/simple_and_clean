name: ci

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

# IMAGE_NAME is set in the "Set image name" step at the top of
# each job that needs it (build, publish). We can't use a GitHub
# Actions expression function to lowercase github.repository_owner
# — there is no such function — so we compute it in shell and
# write to $GITHUB_ENV. This matters for mixed-case org names
# like SaCScaffolder; Docker requires lowercase repo names.

jobs:
  test:
    name: lint + typecheck + test
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: "20"
          cache: npm
          cache-dependency-path: package-lock.json

      - name: npm ci
        run: npm ci --no-audit --no-fund

      - name: typecheck
        run: npm run typecheck

      - name: lint
        run: npm run lint

      - name: test (with coverage gate)
        run: |
          npm test
          # vitest exits non-zero when below the configured threshold, but
          # we re-assert here so the failure is loud in CI logs.
          COVERAGE=$(cat coverage/coverage-summary.json | jq '.total.lines.pct')
          echo "total line coverage: ${COVERAGE}%"
          awk -v want={{ coverage_threshold }} -v got="$COVERAGE" 'BEGIN { if (got+0 < want+0) { exit 1 } }'

      - name: Upload coverage
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: coverage
          path: coverage/

  build:
    name: build + scan
    runs-on: ubuntu-latest
    needs: test
    permissions:
      contents: read
      packages: write
    steps:
      - name: Set image name
        run: |
          {% raw %}OWNER=$(echo "${{ github.repository_owner }}" | tr '[:upper:]' '[:lower:]')
          REPO=$(echo "${{ github.event.repository.name }}" | tr '[:upper:]' '[:lower:]'){% endraw %}
          echo "IMAGE_NAME={{ registry_hostname }}/${OWNER}/${REPO}" >> "$GITHUB_ENV"
      - uses: actions/checkout@v4

      - name: Build image
        # Pass VITE_API_BASE_URL so the bundle is configured at build time.
        # Vite inlines import.meta.env.VITE_* at build.
        run: {% raw %}docker build \
          --build-arg VITE_API_BASE_URL=${VITE_API_BASE_URL:-/api} \
          -t $IMAGE_NAME:${{ github.sha }} .{% endraw %}

      - name: Scan image (Trivy)
        uses: aquasecurity/trivy-action@0.20.0
        with:
          image-ref: {% raw %}$IMAGE_NAME:${{ github.sha }}{% endraw %}
          severity: HIGH,CRITICAL
          exit-code: "1"
          ignore-unfixed: true

{% if ci_provider == 'github-actions' %}
  publish:
    name: publish
    runs-on: ubuntu-latest
    needs: [test, build]
    if: {% raw %}github.event_name == 'push' && github.ref == 'refs/heads/main'{% endraw %}
    # The publish job pushes to {{ registry_hostname }} -- that push uses
    # an App installation token (minted in this job below), NOT
    # GITHUB_TOKEN, because GITHUB_TOKEN's packages: write is repo-scoped
    # and the image is in the org's package namespace. So we keep the
    # GITHUB_TOKEN scope minimal here: just contents: read.
    permissions:
      contents: read
    steps:
      - name: Set image name
        run: |
          {% raw %}OWNER=$(echo "${{ github.repository_owner }}" | tr '[:upper:]' '[:lower:]')
          REPO=$(echo "${{ github.event.repository.name }}" | tr '[:upper:]' '[:lower:]'){% endraw %}
          echo "IMAGE_NAME={{ registry_hostname }}/${OWNER}/${REPO}" >> "$GITHUB_ENV"
      - uses: actions/checkout@v4

      # Mint an App installation token for the docker login. The image
      # name is per-repo (see "Set image name" step) so the image
      # lives in the current repo's package namespace on {{ registry_hostname }},
      # and the App installation's repo-level Packages: write covers
      # it. GITHUB_TOKEN's packages: write is also repo-level but
      # requires the org's "Workflow permissions" setting to be
      # "Read and write" -- we use the App token instead to avoid
      # that org-level coupling.
      #
      # Previously the image name was the service name, not the repo
      # name, which put the image in the org's package namespace and
      # required org-level packages: write on the App installation.
      # The org doesn't grant that scope (verified via run 37877401703,
      # 2026-10-09), so the previous design pushed to an unauthorized
      # location and failed with
      # `installation not allowed to Write organization package`.
      # Per-repo image names sidestep the org-package grant entirely.
      #
      # APP_ID and APP_PRIVATE_KEY are expected to be available as
      # org-level secrets (preferred -- inherited by every repo
      # including the per-PR `_pr_<n>` repos the integration test
      # creates) or as repo-level secrets on every scaffolded repo.
      - name: Mint installation token from GitHub App
        id: app-token
        uses: actions/create-github-app-token@v1
        with:
          app-id: {% raw %}${{ secrets.APP_ID }}{% endraw %}
          private-key: {% raw %}${{ secrets.APP_PRIVATE_KEY }}{% endraw %}
          owner: {% raw %}${{ github.repository_owner }}{% endraw %}

      - uses: docker/login-action@v3
        with:
          registry: {{ registry }}
          username: {% raw %}${{ github.actor }}{% endraw %}
          password: {% raw %}${{ steps.app-token.outputs.token }}{% endraw %}

      - name: Push image
        run: |
          {% raw %}docker tag $IMAGE_NAME:${{ github.sha }} $IMAGE_NAME:latest
          docker push $IMAGE_NAME:${{ github.sha }}
          docker push $IMAGE_NAME:latest{% endraw %}
{% endif %}