name: ci

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

# IMAGE_NAME is set in the "Set image name" step at the top of
# each job that needs it (build, publish). We can't use a GitHub
# Actions expression function to lowercase github.repository_owner
# — there is no such function — so we compute it in shell and
# write to $GITHUB_ENV. This matters for mixed-case org names
# like SaCScaffolder; Docker requires lowercase repo names.

jobs:
  test:
    name: lint + typecheck + test
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: "20"
          cache: npm
          cache-dependency-path: package-lock.json

      - name: npm ci
        run: npm ci --no-audit --no-fund

      - name: typecheck
        run: npm run typecheck

      - name: lint
        run: npm run lint

      - name: test (with coverage gate)
        run: |
          npm test
          # vitest exits non-zero when below the configured threshold, but
          # we re-assert here so the failure is loud in CI logs.
          COVERAGE=$(cat coverage/coverage-summary.json | jq '.total.lines.pct')
          echo "total line coverage: ${COVERAGE}%"
          awk -v want={{ coverage_threshold }} -v got="$COVERAGE" 'BEGIN { if (got+0 < want+0) { exit 1 } }'

      - name: Upload coverage
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: coverage
          path: coverage/

  build:
    name: build + scan
    runs-on: ubuntu-latest
    needs: test
    permissions:
      contents: read
      packages: write
    steps:
      - name: Set image name
        run: |
          {% raw %}OWNER=$(echo "${{ github.repository_owner }}" | tr '[:upper:]' '[:lower:]')
          REPO=$(echo "${{ github.event.repository.name }}" | tr '[:upper:]' '[:lower:]'){% endraw %}
{% if registry == 'gar' %}
          # GAR image paths are `<region>-docker.pkg.dev/<project-id>/<repo>`.
          # The org (`${OWNER}`) is the *GitHub* org and is unrelated to the
          # GCP project the registry lives in — we use the project ID baked
          # into the spec at scaffold time instead. Lowercased to satisfy
          # Docker's image-ref requirements.
          echo "IMAGE_NAME={{ registry_hostname }}/{{ gcp_project_id | lower }}/${REPO}" >> "$GITHUB_ENV"
{% elif registry == 'ghcr' %}
          # GHCR *repo-package* format is `ghcr.io/<owner>/<repo>/<image>`.
          # Without the trailing `/${SERVICE}` segment, the image lands in
          # the *user/org* package namespace, which GITHUB_TOKEN cannot
          # write to. See PR #101.
          echo "IMAGE_NAME={{ registry_hostname }}/${OWNER}/${REPO}/{{ service_name }}" >> "$GITHUB_ENV"
{% else %}
          echo "IMAGE_NAME={{ registry_hostname }}/${OWNER}/${REPO}" >> "$GITHUB_ENV"
{% endif %}
      - uses: actions/checkout@v4

      - name: Build image
        # Pass VITE_API_BASE_URL so the bundle is configured at build time.
        # Vite inlines import.meta.env.VITE_* at build.
        # IMAGE_SOURCE / IMAGE_URL are the OCI labels GitHub Packages
        # uses to auto-link this image to the current repo on first
        # push -- without them, GITHUB_TOKEN's Packages: write scope
        # doesn't apply and the push fails with write_package denied.
        # See PR #103 and the comment block in the Dockerfile.
        run: {% raw %}docker build \
          --build-arg VITE_API_BASE_URL=${VITE_API_BASE_URL:-/api} \
          --build-arg IMAGE_SOURCE="https://github.com/${{ github.repository }}" \
          --build-arg IMAGE_URL="https://github.com/${{ github.repository }}" \
          -t $IMAGE_NAME:${{ github.sha }} .{% endraw %}

      - name: Scan image (Trivy)
        uses: aquasecurity/trivy-action@v0.36.0
        with:
          image-ref: {% raw %}$IMAGE_NAME:${{ github.sha }}{% endraw %}
          severity: HIGH,CRITICAL
          exit-code: "1"
          ignore-unfixed: true

{% if ci_provider == 'github-actions' and registry != 'gar' %}
  # GAR pushes don't use GITHUB_TOKEN; they need GCP auth (WIF or a SA key).
  # The GAR-aware push path is in deploy/gcp/deploy.yml.j2; users wire that
  # to workflow_dispatch or push-to-main. See PR #99 for the long form.
  publish:
    name: publish
    runs-on: ubuntu-latest
    needs: [test, build]
    if: {% raw %}github.event_name == 'push' && github.ref == 'refs/heads/main'{% endraw %}
    # The publish job pushes to {{ registry_hostname }} with GITHUB_TOKEN.
    # The image is in the current repo's own package namespace (see
    # "Set image name" step), so GITHUB_TOKEN's repo-level packages: write
    # covers the push. We still keep contents: read for checkout (no
    # code is written back).
    permissions:
      contents: read
      packages: write
    steps:
      - name: Set image name
        run: |
          {% raw %}OWNER=$(echo "${{ github.repository_owner }}" | tr '[:upper:]' '[:lower:]')
          REPO=$(echo "${{ github.event.repository.name }}" | tr '[:upper:]' '[:lower:]'){% endraw %}
{% if registry == 'gar' %}
          # GAR image paths are `<region>-docker.pkg.dev/<project-id>/<repo>`.
          # The org (`${OWNER}`) is the *GitHub* org and is unrelated to the
          # GCP project the registry lives in — we use the project ID baked
          # into the spec at scaffold time instead. Lowercased to satisfy
          # Docker's image-ref requirements.
          echo "IMAGE_NAME={{ registry_hostname }}/{{ gcp_project_id | lower }}/${REPO}" >> "$GITHUB_ENV"
{% elif registry == 'ghcr' %}
          # GHCR *repo-package* format is `ghcr.io/<owner>/<repo>/<image>`.
          # Without the trailing `/${SERVICE}` segment, the image lands in
          # the *user/org* package namespace, which GITHUB_TOKEN cannot
          # write to. See PR #101.
          echo "IMAGE_NAME={{ registry_hostname }}/${OWNER}/${REPO}/{{ service_name }}" >> "$GITHUB_ENV"
{% else %}
          echo "IMAGE_NAME={{ registry_hostname }}/${OWNER}/${REPO}" >> "$GITHUB_ENV"
{% endif %}
      - uses: actions/checkout@v4
      # Log in to {{ registry }} with the workflow's GITHUB_TOKEN. The
      # image is in the current repo's own package namespace (see
      # "Set image name" step), so GITHUB_TOKEN's repo-level
      # packages: write covers the push. This is the standard
      # GitHub-supported way to push to ghcr.io -- the docs note that
      # GitHub Packages only supports authentication using a personal
      # access token (classic) or GITHUB_TOKEN, not GitHub App
      # installation tokens
      # (https://docs.github.com/en/packages/working-with-a-github-packages-registry/working-with-the-container-registry).
      # The org's "Workflow permissions" setting must be "Read and
      # write" for GITHUB_TOKEN to carry that scope.
      - uses: docker/login-action@v3
        with:
          registry: {{ registry_hostname }}
          username: {% raw %}${{ github.actor }}{% endraw %}
          password: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}

      - name: "Pre-flight: check for stale mislinked GHCR package"
        if: {% raw %}${{ env.IMAGE_NAME }}{% endraw %}.startsWith('ghcr.io/')
        env:
          GH_TOKEN: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
        run: |
          # PR #103: see the same step in go-webapi/ci.yml.j2 for context.
          set -euo pipefail
          {% raw %}OWNER=$(echo "${{ github.repository_owner }}" | tr '[:upper:]' '[:lower:]')
          PKG_NAME=$(echo "$IMAGE_NAME" | sed 's|^ghcr.io/||')
          HTTP_CODE=$(curl -s -o /tmp/pkg_check.json -w "%{http_code}" \
            -H "Authorization: Bearer $GH_TOKEN" \
            -H "Accept: application/vnd.github+json" \
            -H "X-GitHub-Api-Version: 2022-11-28" \
            "https://api.github.com/orgs/${OWNER}/packages/container/${PKG_NAME}")
          case "$HTTP_CODE" in
            404)
              echo "Pre-flight OK: package ${PKG_NAME} does not exist in the org namespace yet."
              ;;
            200)
              echo "::error::GHCR package '${PKG_NAME}' already exists in the org namespace."
              echo "::error::This usually means a previous run of a different (rescaffolded) repo created it without the OCI image.source label."
              echo "::error::The current repo's GITHUB_TOKEN can't write to it -- push would fail with 'permission_denied: write_package'."
              echo "::error::"
              echo "::error::Recovery: delete the stale package with a token that has delete:packages scope, then re-run this job:"
              echo "::error::  gh api -X DELETE /orgs/${OWNER}/packages/container/${PKG_NAME} -H 'Authorization: Bearer <PAT with delete:packages>'"
              echo "::error::"
              cat /tmp/pkg_check.json
              exit 1
              ;;
            *)
              echo "::warning::Pre-flight got unexpected HTTP ${HTTP_CODE} checking package ${PKG_NAME}. Continuing."
              cat /tmp/pkg_check.json
              ;;
          esac{% endraw %}
      - name: Push image
        run: |
          # The OCI image.source label was set during the build step
          # via --build-arg (see PR #103). It tells GHCR to auto-link
          # this image to the current repo, so GITHUB_TOKEN's
          # Packages: write covers the push.
          {% raw %}docker tag $IMAGE_NAME:${{ github.sha }} $IMAGE_NAME:latest
          docker push $IMAGE_NAME:${{ github.sha }}
          docker push $IMAGE_NAME:latest{% endraw %}
  # PR #104: tagged-release publishing. Runs only on v* tag pushes
  # (e.g. v1.2.3, v1.2.3-rc.1). Derives the major/minor/patch from
  # the tag and pushes the image with five labels:
  #   :X.Y.Z       -- exact pinned version
  #   :X.Y         -- tracks the latest X.Y patch release
  #   :X           -- tracks the latest X major release
  #   :<sha>       -- the immutable build (same as the main push)
  #   :latest      -- mutable pointer to the most recent tag push
  #
  # Note on prereleases: :latest is updated on every tag push,
  # including v1.2.3-rc.1. If you don't want that, push the
  # prerelease tag from a non-default branch or use a downstream
  # :X.Y.Z-pinned pull policy. We chose to keep :latest always
  # tag-driven rather than branching on the prerelease suffix
  # because the alternative is significantly more complex for a
  # marginal safety win.
  publish-tagged:
    name: publish (tagged release)
    if: {% raw %}startsWith(github.ref, 'refs/tags/v'){% endraw %}
    needs: [test, build]
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
    steps:
      - uses: actions/checkout@v4
      - name: Set image name
        run: |
          {% raw %}OWNER=$(echo "${{ github.repository_owner }}" | tr '[:upper:]' '[:lower:]')
          REPO=$(echo "${{ github.event.repository.name }}" | tr '[:upper:]' '[:lower:]'){% endraw %}
{% if registry == 'gar' %}
          echo "IMAGE_NAME={{ registry_hostname }}/{{ gcp_project_id | lower }}/${REPO}" >> "$GITHUB_ENV"
{% elif registry == 'ghcr' %}
          echo "IMAGE_NAME={{ registry_hostname }}/${OWNER}/${REPO}/{{ service_name }}" >> "$GITHUB_ENV"
{% else %}
          echo "IMAGE_NAME={{ registry_hostname }}/${OWNER}/${REPO}" >> "$GITHUB_ENV"
{% endif %}
      - name: Derive version tags from the ref name
        id: version
        run: |
          # github.ref_name is the tag without refs/tags/. For
          # v1.2.3 -> "v1.2.3"; for v1.2.3-rc.1 -> "v1.2.3-rc.1".
          VER="{% raw %}${{ github.ref_name }}{% endraw %}"
          VER_NO_V="${VER#v}"
          if ! echo "$VER_NO_V" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$'; then
            echo "::error::Tag '${VER}' is not a valid semver (expected vX.Y.Z or vX.Y.Z-pre.N)."
            exit 1
          fi
          MAJOR="${VER_NO_V%%.*}"
          REST="${VER_NO_V#*.}"
          MINOR="${REST%%.*}"
          PATCH="${REST#*.}"
          # Strip any prerelease suffix from PATCH (e.g. 3-rc.1 -> 3)
          PATCH="${PATCH%%-*}"
          IS_PRERELEASE="false"
          if [[ "$VER_NO_V" == *-* ]]; then
            IS_PRERELEASE="true"
          fi
          echo "version=${VER_NO_V}" >> "$GITHUB_OUTPUT"
          echo "major=${MAJOR}" >> "$GITHUB_OUTPUT"
          echo "minor=${MINOR}" >> "$GITHUB_OUTPUT"
          echo "patch=${PATCH}" >> "$GITHUB_OUTPUT"
          echo "is_prerelease=${IS_PRERELEASE}" >> "$GITHUB_OUTPUT"
          echo "Resolved ${VER} -> version=${VER_NO_V} major=${MAJOR} minor=${MINOR} patch=${PATCH} is_prerelease=${IS_PRERELEASE}"
      - name: Log in to {{ registry_hostname }}
        uses: docker/login-action@v3
        with:
          registry: {{ registry_hostname }}
          username: {% raw %}${{ github.actor }}{% endraw %}
          password: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
      - name: Build image (tagged release)
        # The main `build` job's image doesn't survive across
        # runners, so publish-tagged has to build its own copy.
        # Build args are templated to bake in the OCI image.source
        # label so GHCR auto-links the package to this repo on
        # first push. See PR #103.
        run: |
          # The OCI image.source label is the key to GHCR's auto-link
          # of freshly-pushed packages to the current repo. See PR #103
          # and the comment block in the Dockerfile for the full story.
          {% raw %}docker build \
            --build-arg IMAGE_SOURCE="https://github.com/${{ github.repository }}" \
            --build-arg IMAGE_URL="https://github.com/${{ github.repository }}" \
            -t $IMAGE_NAME:${{ steps.version.outputs.version }} .{% endraw %}
      - name: Push semver tags
        run: |
          # Push :X.Y.Z, :X.Y, :X, :<sha>, and :latest. The
          # :<sha> tag is the same as the main push, so a
          # downstream consumer can always pin to the immutable
          # build even after :latest moves on. The :latest tag
          # is included unconditionally (including for prereleases,
          # see the comment block at the top of this job for the
          # rationale).
          {% raw %}VER="${{ steps.version.outputs.version }}"
          MAJOR="${{ steps.version.outputs.major }}"
          MINOR="${{ steps.version.outputs.minor }}"
          for tag in "${VER}" "${MAJOR}.${MINOR}" "${MAJOR}" "${{ github.sha }}" "latest"; do
            docker tag "$IMAGE_NAME:${VER}" "$IMAGE_NAME:${tag}"
            docker push "$IMAGE_NAME:${tag}"
          done{% endraw %}

{% endif %}