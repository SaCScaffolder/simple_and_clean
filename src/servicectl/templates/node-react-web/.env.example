# Copy to .env for local dev. Never commit a real .env.

# Public API base URL for the backend this frontend talks to.
# In dev, vite proxies /api to VITE_API_PROXY_TARGET (see vite.config.ts).
# In prod, set this to the canonical backend URL.
VITE_API_BASE_URL=http://localhost:8080

# Optional: the URL Vite's proxy forwards /api requests to in dev.
# Only used by the dev server; not bundled into production builds.
VITE_API_PROXY_TARGET=http://localhost:8080